@model TicketCatalog
@{
    ViewData["Title"] = "Chi tiết danh mục phiếu";
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Danh mục phiếu</a>
        <h5 class="fw-bold mb-1 mt-1">@Html.Raw(Ui.CatalogKindBadge(Model.Kind)) <span class="font-monospace">@Model.Code</span>
            @if(Model.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}
            else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</h5>
        <div class="text-muted small">@Model.AgentName · tạo @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Sửa</a>
        <form asp-action="Toggle" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-sm @(Model.IsActive?"btn-outline-secondary":"btn-primary")">
                <i class="bi bi-toggle-@(Model.IsActive?"off":"on") me-1"></i>@(Model.IsActive?"Ngừng dùng":"Kích hoạt")</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Loại danh mục</div><div class="fs-6 fw-bold">@Ui.CatalogKindName(Model.Kind)</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Mã</div><div class="fs-5 fw-bold font-monospace">@Model.Code</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Phạm vi sử dụng</div><div class="fs-6 fw-bold">@Ui.CatalogUseTypeName(Model.UseType)</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Cập nhật</div><div class="fs-5 fw-bold">@Model.UpdatedAt.ToString("dd/MM/yyyy")</div></div></div></div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Remark))
{
    <div class="alert alert-light border"><i class="bi bi-info-circle me-1"></i>@Model.Remark</div>
}

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-card-text me-1"></i>Tên hiển thị</h6>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>Đối tượng</th><th>Tên hiển thị</th></tr></thead>
        <tbody>
            <tr><td><i class="bi bi-person-badge me-1"></i>Agent</td><td>@Model.AgentName</td></tr>
            <tr><td><i class="bi bi-person me-1"></i>Khách hàng</td><td>@Model.CustomerName</td></tr>
        </tbody>
    </table></div>
</div></div>
