@model List<TicketCatalog>
@{
    ViewData["Title"] = "Danh mục phiếu";
    var stats = (TicketCatalogStats)ViewBag.Stats;
    var kind = (TicketCatalogKind?)ViewBag.Kind;
    var active = (bool?)ViewBag.Active;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-tags me-2"></i>Danh mục phiếu</h5>
        <small class="text-muted">Trạng thái · Mức ưu tiên · Nguồn phiếu · Kênh tiếp nhận (Mst_TicketStatus/Priority/Source/ReceptionChannel)</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm danh mục</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng danh mục</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-tags fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Trạng thái / Ưu tiên</div><div class="fs-3 fw-bold text-warning">@stats.Status / @stats.Priority</div></div>
        <i class="bi bi-flag fs-2 text-warning opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Nguồn / Kênh</div><div class="fs-3 fw-bold text-info">@stats.Source / @stats.ReceptionChannel</div></div>
        <i class="bi bi-inboxes fs-2 text-info opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Loại danh mục</label>
        <select name="kind" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            @foreach (var k in Enum.GetValues<TicketCatalogKind>())
            {
                <option value="@k" selected="@(kind==k)">@Ui.CatalogKindName(k)</option>
            }
        </select></div>
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / tên agent / tên khách" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Loại</th><th>Mã</th><th>Tên cho agent</th><th>Tên cho khách</th><th>Phạm vi</th><th>Trạng thái</th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có danh mục phiếu</td></tr>}
        @foreach (var c in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/TicketCatalog/Details/@c.Id'">
                <td>@Html.Raw(Ui.CatalogKindBadge(c.Kind))</td>
                <td><span class="font-monospace small fw-semibold">@c.Code</span>
                    @if(!string.IsNullOrWhiteSpace(c.Remark)){<div class="small text-muted">@c.Remark</div>}</td>
                <td>@c.AgentName</td>
                <td class="text-muted">@c.CustomerName</td>
                <td class="small text-muted">@Ui.CatalogUseTypeName(c.UseType)</td>
                <td>@if(c.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</td>
            </tr>
        }
    </tbody>
</table></div></div>
