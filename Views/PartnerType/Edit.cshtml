@model PartnerTypeCatalog
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm đối tượng khách hàng" : "Sửa đối tượng khách hàng";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Đối tượng khách hàng</a>
        <h5 class="fw-bold mb-0 mt-1">@ViewData["Title"]</h5>
    </div>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card mb-3"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1"></i>Thông tin đối tượng khách hàng</h6>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label small">Mã đối tượng (PartnerType)</label>
                <input name="Code" value="@Model.Code" class="form-control form-control-sm" placeholder="VD: CUSTOMER / SUPPLIER / BOTH" />
                <div class="form-text">Để trống sẽ tự sinh mã.</div></div>
            <div class="col-md-4"><label class="form-label small">Tên đối tượng (PartnerTypeName) <span class="text-danger">*</span></label>
                <input name="Name" value="@Model.Name" class="form-control form-control-sm" placeholder="VD: Khách hàng" required /></div>
            <div class="col-md-4"><label class="form-label small">Trạng thái</label>
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                    <label class="form-check-label small" for="isActive">Đang dùng (FlagActive)</label></div></div>
        </div>
    </div></div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Lưu đối tượng</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy</a>
    </div>
</form>
