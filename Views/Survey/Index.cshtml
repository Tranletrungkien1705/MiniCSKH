@model List<SurveyForm>
@{
    ViewData["Title"] = "Mẫu khảo sát";
    var stats = (SurveyStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-clipboard-check me-2"></i>Mẫu khảo sát hài lòng</h5>
        <small class="text-muted">Thiết lập mẫu khảo sát dùng để đánh giá phiếu sau khi đóng</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Tạo mẫu</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng mẫu</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-clipboard-check fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đã sử dụng</div><div class="fs-3 fw-bold text-info">@stats.Used</div></div>
        <i class="bi bi-clock-history fs-2 text-info opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng trường</div><div class="fs-3 fw-bold text-warning">@stats.Fields</div></div>
        <i class="bi bi-list-check fs-2 text-warning opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Tên / mã mẫu" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Tên mẫu</th><th>Trường</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có mẫu khảo sát</td></tr>}
        @foreach (var f in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/Survey/Details/@f.Id'">
                <td class="font-monospace small fw-semibold">@f.Code</td>
                <td>@f.Name<div class="small text-muted">@f.Description</div></td>
                <td><span class="badge bg-light text-dark border">@f.FieldCount trường</span>
                    @if(f.RequiredCount>0){<span class="badge bg-warning-subtle text-warning border-warning-subtle">@f.RequiredCount bắt buộc</span>}</td>
                <td>@if(f.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</td>
                <td class="small text-muted">@f.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table></div></div>
