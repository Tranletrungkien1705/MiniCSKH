@model CampaignType
@{
    ViewData["Title"] = Model.Id == 0 ? "Tạo loại chiến dịch" : "Sửa loại chiến dịch";
    var columns = Model.Columns.OrderBy(c => c.Order).ToList();
    if (columns.Count == 0) columns.Add(new CampaignTypeColumn { FieldType = SurveyFieldType.Text });
    var feedbacks = Model.Feedbacks.ToList();
    if (feedbacks.Count == 0) feedbacks.Add(new CampaignFeedback());
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Loại chiến dịch</a>
        <h5 class="fw-bold mb-0 mt-1">@ViewData["Title"]</h5>
    </div>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card mb-3"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1"></i>Thông tin loại chiến dịch</h6>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label small">Mã loại <span class="text-danger">*</span></label>
                <input name="Code" value="@Model.Code" class="form-control form-control-sm font-monospace" placeholder="VD: TELESALES" required /></div>
            <div class="col-md-8"><label class="form-label small">Tên loại <span class="text-danger">*</span></label>
                <input name="Name" value="@Model.Name" class="form-control form-control-sm" placeholder="VD: Telesales / Chăm sóc" required /></div>
            <div class="col-12"><label class="form-label small">Mô tả</label>
                <textarea name="Description" class="form-control form-control-sm" rows="2">@Model.Description</textarea></div>
            <div class="col-md-6"><label class="form-label small">Ghi chú</label>
                <input name="Remark" value="@Model.Remark" class="form-control form-control-sm" /></div>
            <div class="col-md-6 d-flex align-items-end"><div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label small" for="isActive">Đang dùng (FlagActive)</label></div></div>
        </div>
    </div></div>

    <div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0"><i class="bi bi-input-cursor-text me-1"></i>Trường tùy chỉnh</h6>
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="addCol()"><i class="bi bi-plus-lg me-1"></i>Thêm trường</button>
        </div>
        <div class="table-responsive"><table class="table align-middle mb-0" id="colTable">
            <thead><tr><th style="width:50%">Tên trường</th><th style="width:25%">Kiểu</th><th style="width:15%">Bắt buộc</th><th style="width:40px"></th></tr></thead>
            <tbody>
                @foreach (var c in columns)
                {
                    <tr>
                        <td><input name="colName" value="@c.Name" class="form-control form-control-sm" placeholder="VD: Ngân sách dự kiến" /></td>
                        <td><select name="colType" class="form-select form-select-sm">
                            @foreach (SurveyFieldType t in Enum.GetValues<SurveyFieldType>())
                            {<option value="@t" selected="@(c.FieldType==t)">@Ui.SurveyFieldTypeName(t)</option>}
                        </select></td>
                        <td class="text-center"><input type="checkbox" name="colRequired" value="on" class="form-check-input" @(c.IsRequired ? "checked" : "") /></td>
                        <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>
                    </tr>
                }
            </tbody>
        </table></div>
    </div></div>

    <div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0"><i class="bi bi-chat-left-quote me-1"></i>Phản hồi khách hàng</h6>
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="addFb()"><i class="bi bi-plus-lg me-1"></i>Thêm phản hồi</button>
        </div>
        <div class="table-responsive"><table class="table align-middle mb-0" id="fbTable">
            <thead><tr><th>Tên phản hồi</th><th style="width:40px"></th></tr></thead>
            <tbody>
                @foreach (var f in feedbacks)
                {
                    <tr>
                        <td><input name="fbName" value="@f.Name" class="form-control form-control-sm" placeholder="VD: Đồng ý mua thêm" /></td>
                        <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>
                    </tr>
                }
            </tbody>
        </table></div>
    </div></div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Lưu loại chiến dịch</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy</a>
    </div>
</form>

@section Scripts {
<script>
    function addCol() {
        const tb = document.querySelector('#colTable tbody');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><input name="colName" class="form-control form-control-sm" placeholder="VD: Ngân sách dự kiến" /></td>
            <td><select name="colType" class="form-select form-select-sm">
                @foreach (SurveyFieldType t in Enum.GetValues<SurveyFieldType>())
                {<text><option value="@t">@Ui.SurveyFieldTypeName(t)</option></text>}
            </select></td>
            <td class="text-center"><input type="checkbox" name="colRequired" value="on" class="form-check-input" /></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>`;
        tb.appendChild(tr);
    }
    function addFb() {
        const tb = document.querySelector('#fbTable tbody');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><input name="fbName" class="form-control form-control-sm" placeholder="VD: Đồng ý mua thêm" /></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>`;
        tb.appendChild(tr);
    }
</script>
}