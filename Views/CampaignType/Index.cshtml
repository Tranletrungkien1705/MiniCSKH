@model List<CampaignType>
@{
    ViewData["Title"] = "Loại chiến dịch";
    var stats = (CampaignTypeStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-megaphone-fill me-2"></i>Loại chiến dịch</h5>
        <small class="text-muted">Phân loại chiến dịch gọi ra, gắn trường tùy chỉnh &amp; phản hồi khách hàng (Mst_CampaignType)</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm loại</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng loại</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-megaphone fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Trường tùy chỉnh</div><div class="fs-3 fw-bold text-info">@stats.Columns</div></div>
        <i class="bi bi-input-cursor-text fs-2 text-info opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Phản hồi KH</div><div class="fs-3 fw-bold text-warning">@stats.Feedbacks</div></div>
        <i class="bi bi-chat-left-quote fs-2 text-warning opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / tên / mô tả" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Tên loại chiến dịch</th><th>Trường tùy chỉnh</th><th>Phản hồi KH</th><th>Trạng thái</th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có loại chiến dịch</td></tr>}
        @foreach (var t in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/CampaignType/Details/@t.Id'">
                <td><span class="font-monospace small fw-semibold">@t.Code</span></td>
                <td class="fw-semibold"><i class="bi bi-megaphone me-1 text-muted"></i>@t.Name
                    @if(!string.IsNullOrWhiteSpace(t.Description)){<div class="small text-muted">@t.Description</div>}</td>
                <td><span class="badge bg-info-subtle text-info border-info-subtle">@t.ColumnCount trường</span>
                    @if(t.RequiredColumnCount>0){<span class="badge bg-warning-subtle text-warning border-warning-subtle">@t.RequiredColumnCount bắt buộc</span>}</td>
                <td><span class="badge bg-light text-dark border">@t.FeedbackCount</span></td>
                <td>@Html.Raw(Ui.CampaignTypeActiveBadge(t.IsActive))</td>
            </tr>
        }
    </tbody>
</table></div></div>