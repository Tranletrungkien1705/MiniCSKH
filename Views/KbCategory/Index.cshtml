@model List<KbCategory>
@{
    ViewData["Title"] = "Danh mục bài viết KB";
    var stats = (KbCategoryStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var parentCode = (string?)ViewBag.ParentCode;
    var q = (string?)ViewBag.Q;
    var parents = (List<KbCategory>)ViewBag.Parents;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-folder2-open me-2"></i>Danh mục bài viết KB</h5>
        <small class="text-muted">Cây phân loại bài viết tri thức (KB_Category)</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm danh mục</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng danh mục</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-folder2-open fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Gốc / Danh mục con</div><div class="fs-3 fw-bold text-info">@stats.Root / @stats.Child</div></div>
        <i class="bi bi-diagram-3 fs-2 text-info opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Bài viết</div><div class="fs-3 fw-bold text-warning">@stats.Posts</div></div>
        <i class="bi bi-journal-richtext fs-2 text-warning opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col-auto"><label class="form-label small mb-1">Danh mục cha</label>
        <select name="parentCode" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            @foreach (var p in parents)
            {
                <option value="@p.Code" selected="@(parentCode==p.Code)">@p.Code — @p.Name</option>
            }
        </select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / tên / mô tả danh mục" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Tên danh mục</th><th>Danh mục cha</th><th>Loại chia sẻ</th><th>Bài viết</th><th>Trạng thái</th><th style="width:90px"></th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có danh mục nào</td></tr>}
        @foreach (var m in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/KbCategory/Details/@m.Id'">
                <td class="font-monospace small">@m.Code</td>
                <td class="fw-semibold">@m.Name</td>
                <td>@(string.IsNullOrWhiteSpace(m.ParentCode) ? Html.Raw("<span class='text-muted small'>— gốc —</span>") : Html.Raw($"<span class='badge bg-light text-dark border font-monospace'>{m.ParentCode}</span>"))</td>
                <td>@Html.Raw(Ui.KbShareTypeBadge(m.ShareType))</td>
                <td><span class="badge bg-secondary-subtle text-secondary">@m.PostCount</span></td>
                <td>@Html.Raw(Ui.KbCategoryActiveBadge(m.IsActive))</td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-outline-primary btn-sm" onclick="event.stopPropagation()"><i class="bi bi-pencil"></i></a></td>
            </tr>
        }
    </tbody>
</table></div></div>
