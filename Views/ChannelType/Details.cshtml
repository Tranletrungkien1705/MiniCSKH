@model ChannelType
@{
    ViewData["Title"] = "Chi tiết loại kênh";
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Loại kênh</a>
        <h5 class="fw-bold mb-1 mt-1"><i class="bi @Ui.ChannelTypeIcon(Model.Code) me-1"></i>@Model.Name <span class="font-monospace text-muted">@Model.Code</span>
            @Html.Raw(Ui.ChannelTypeActiveBadge(Model.IsActive))</h5>
        <div class="text-muted small">tạo @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") · cập nhật @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Sửa</a>
        <form asp-action="Toggle" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-sm @(Model.IsActive?"btn-outline-secondary":"btn-primary")">
                <i class="bi bi-toggle-@(Model.IsActive?"off":"on") me-1"></i>@(Model.IsActive?"Ngừng dùng":"Kích hoạt")</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Mã (ChannelType)</div><div class="fs-5 fw-bold font-monospace">@Model.Code</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Tên (ChannelTypeName)</div><div class="fs-6 fw-bold">@Model.Name</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Trạng thái (FlagActive)</div>
        <div class="fs-6 fw-bold">@Html.Raw(Ui.ChannelTypeActiveBadge(Model.IsActive))</div></div></div></div>
</div>

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-broadcast me-1"></i>Thông tin loại kênh</h6>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>Thuộc tính</th><th>Giá trị</th></tr></thead>
        <tbody>
            <tr><td><i class="bi bi-upc me-1"></i>Mã (ChannelType)</td><td class="font-monospace">@Model.Code</td></tr>
            <tr><td><i class="bi bi-tag me-1"></i>Tên (ChannelTypeName)</td><td>@Model.Name</td></tr>
            <tr><td><i class="bi bi-toggle-on me-1"></i>Trạng thái (FlagActive)</td><td>@Html.Raw(Ui.ChannelTypeActiveBadge(Model.IsActive))</td></tr>
            <tr><td><i class="bi bi-person me-1"></i>Người tạo (LogLUBy)</td><td>@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "—" : Model.CreatedBy)</td></tr>
        </tbody>
    </table></div>
</div></div>
