@model ReceiveNotify
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm người nhận thông báo" : "Sửa người nhận thông báo";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Người nhận thông báo phiếu</a>
        <h5 class="fw-bold mb-0 mt-1">@ViewData["Title"]</h5>
    </div>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card mb-3"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1"></i>Thông tin người nhận</h6>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label small">Mã agent (AgentCode) <span class="text-danger">*</span></label>
                <input name="AgentCode" value="@Model.AgentCode" class="form-control form-control-sm" placeholder="VD: ha.nguyen" required />
                <div class="form-text">Mã nhân viên (Sys_User.UserCode) sẽ nhận thông báo.</div></div>
            <div class="col-md-4"><label class="form-label small">Tên agent (su_UserName)</label>
                <input name="AgentName" value="@Model.AgentName" class="form-control form-control-sm" placeholder="VD: Nguyễn Thu Hà" /></div>
            <div class="col-md-4"><label class="form-label small">Ghi chú (Remark)</label>
                <input name="Remark" value="@Model.Remark" class="form-control form-control-sm" placeholder="Ghi chú" /></div>
        </div>
    </div></div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Lưu người nhận</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy</a>
    </div>
</form>