@model ReceiveNotify
@{
    ViewData["Title"] = "Chi tiết người nhận thông báo";
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Người nhận thông báo phiếu</a>
        <h5 class="fw-bold mb-1 mt-1"><i class="bi bi-person-badge me-1"></i>@Model.DisplayName <span class="font-monospace text-muted">@Model.AgentCode</span></h5>
        <div class="text-muted small">tạo @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") · cập nhật @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Sửa</a>
        <form asp-action="Delete" method="post" onsubmit="return confirm('Xóa người nhận thông báo này?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i>Xóa</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Mã agent (AgentCode)</div><div class="fs-6 fw-bold font-monospace">@Model.AgentCode</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Tên agent (su_UserName)</div><div class="fs-6 fw-bold">@(string.IsNullOrWhiteSpace(Model.AgentName) ? "—" : Model.AgentName)</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Người tạo (LogLUBy)</div><div class="fs-6 fw-bold">@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "—" : Model.CreatedBy)</div></div></div></div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Remark))
{
    <div class="alert alert-light border">
        <div><i class="bi bi-info-circle me-1"></i>@Model.Remark</div>
    </div>
}