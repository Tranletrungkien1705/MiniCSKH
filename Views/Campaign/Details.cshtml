@model Campaign
@{
    ViewData["Title"] = "Chi tiết chiến dịch";
    var agents = (List<Agent>)ViewBag.Agents;
    // Nút chuyển trạng thái hợp lệ theo vòng đời SkyCS: Pending→Approve→Started⇄Paused→Finish
    var next = Model.Status switch
    {
        CampaignStatus.Pending => new[] { CampaignStatus.Approved, CampaignStatus.Cancelled },
        CampaignStatus.Approved => new[] { CampaignStatus.Started, CampaignStatus.Cancelled },
        CampaignStatus.Started => new[] { CampaignStatus.Paused, CampaignStatus.Finished },
        CampaignStatus.Paused => new[] { CampaignStatus.Started, CampaignStatus.Finished },
        _ => Array.Empty<CampaignStatus>()
    };
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Chiến dịch</a>
        <h5 class="fw-bold mb-1 mt-1">@Model.Name @Html.Raw(Ui.CampaignStatusBadge(Model.Status))</h5>
        <div class="text-muted small"><span class="font-monospace">@Model.Code</span> · @Model.CampaignType · tạo @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="d-flex gap-2">
        @foreach (var s in next)
        {
            <form asp-action="Status" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="@s" />
                <button class="btn btn-sm @(s==CampaignStatus.Cancelled?"btn-outline-danger":"btn-primary")">@Ui.CampaignStatusName(s)</button>
            </form>
        }
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Tổng khách</div><div class="fs-3 fw-bold">@Model.TotalCustomers</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Đã gọi xong</div><div class="fs-3 fw-bold text-success">@Model.DoneCustomers</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Tiến độ</div><div class="fs-3 fw-bold text-primary">@Model.ProgressPercent%</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Bắt đầu</div><div class="fs-5 fw-bold">@(Model.StartAt?.ToString("dd/MM HH:mm") ?? "—")</div></div></div></div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <div class="alert alert-light border"><i class="bi bi-info-circle me-1"></i>@Model.Description</div>
}

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-people me-1"></i>Danh sách khách hàng</h6>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>Khách hàng</th><th>Số ĐT</th><th>Công ty</th><th>Agent</th><th>Kết quả</th><th>Phản hồi / ghi chú</th><th></th></tr></thead>
        <tbody>
            @if(!Model.Customers.Any()){<tr><td colspan="7" class="text-center text-muted py-4">Chưa có khách hàng</td></tr>}
            @foreach (var cc in Model.Customers.OrderBy(x => x.Status))
            {
                <tr>
                    <td>@cc.CustomerName @if(cc.CallCount>0){<span class="badge bg-light text-muted border ms-1">@cc.CallCount lần</span>}</td>
                    <td class="font-monospace">@cc.PhoneNumber</td>
                    <td class="small">@(cc.Company ?? "—")</td>
                    <td class="small">@(cc.Agent?.Name ?? "—")</td>
                    <td>@Html.Raw(Ui.CustStatusBadge(cc.Status))</td>
                    <td class="small text-muted">@(cc.Feedback ?? cc.Remark)</td>
                    <td class="text-end">
                        <button class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#cc-@cc.Id"><i class="bi bi-pencil"></i></button>
                    </td>
                </tr>
                <tr class="collapse" id="cc-@cc.Id"><td colspan="7" class="bg-light">
                    <form asp-action="SaveCustomer" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="customerId" value="@cc.Id" />
                        <div class="col-md-3"><label class="form-label small mb-1">Agent</label>
                            <select name="agentId" class="form-select form-select-sm"><option value="">—</option>@foreach(var a in agents){<option value="@a.Id" selected="@(cc.AgentId==a.Id)">@a.Name</option>}</select></div>
                        <div class="col-md-3"><label class="form-label small mb-1">Kết quả gọi</label>
                            <select name="status" class="form-select form-select-sm">@foreach(CampaignCustomerStatus s in Enum.GetValues<CampaignCustomerStatus>()){<option value="@s" selected="@(cc.Status==s)">@Ui.CustStatusName(s)</option>}</select></div>
                        <div class="col-md-3"><label class="form-label small mb-1">Phản hồi khách</label><input name="feedback" value="@cc.Feedback" class="form-control form-control-sm" /></div>
                        <div class="col-md-2"><label class="form-label small mb-1">Ghi chú</label><input name="remark" value="@cc.Remark" class="form-control form-control-sm" /></div>
                        <div class="col-md-1"><button class="btn btn-primary btn-sm w-100"><i class="bi bi-check-lg"></i></button></div>
                    </form>
                </td></tr>
            }
        </tbody>
    </table></div>
</div></div>
