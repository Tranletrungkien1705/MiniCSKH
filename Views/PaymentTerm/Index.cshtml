@model List<PaymentTerm>
@{
    ViewData["Title"] = "Điều khoản thanh toán";
    var stats = (PaymentTermStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var type = (PTType?)ViewBag.Type;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-credit-card me-2"></i>Điều khoản thanh toán</h5>
        <small class="text-muted">Quy định cách khách hàng thanh toán — số ngày nợ, hạn mức công nợ, % đặt cọc (Mst_PaymentTerm)</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm điều khoản</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng điều khoản</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-credit-card fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Bán ra / Mua vào</div><div class="fs-3 fw-bold text-info">@stats.Sale / @stats.Purchase</div></div>
        <i class="bi bi-arrow-left-right fs-2 text-info opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Có hạn mức nợ</div><div class="fs-3 fw-bold text-warning">@stats.WithCredit</div></div>
        <i class="bi bi-cash-stack fs-2 text-warning opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Loại</label>
        <select name="type" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="0" selected="@(type==PTType.Sale)">Bán ra</option>
            <option value="1" selected="@(type==PTType.Purchase)">Mua vào</option>
        </select></div>
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / tên / mô tả điều khoản" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Tên điều khoản</th><th>Loại</th><th>Số ngày nợ</th><th>Hạn mức nợ</th><th>Đặt cọc</th><th>Trạng thái</th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có điều khoản thanh toán</td></tr>}
        @foreach (var p in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/PaymentTerm/Details/@p.Id'">
                <td><span class="font-monospace small fw-semibold">@p.Code</span>
                    @if(!string.IsNullOrWhiteSpace(p.Description)){<div class="small text-muted">@p.Description</div>}</td>
                <td class="fw-semibold">@p.Name</td>
                <td>@Html.Raw(Ui.PTTypeBadge(p.Type))</td>
                <td>@if(p.OwedDay>0){<span class="badge bg-light text-dark border">@p.OwedDay ngày</span>}else{<span class="text-muted small">Thanh toán ngay</span>}</td>
                <td class="small">@p.CreditLimitText</td>
                <td class="small">@p.DepositText</td>
                <td>@if(p.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</td>
            </tr>
        }
    </tbody>
</table></div></div>
