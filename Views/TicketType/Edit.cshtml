@model TicketType
@{
    ViewData["Title"] = Model.Id == 0 ? "Tạo phân loại nghiệp vụ" : "Sửa phân loại nghiệp vụ";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Phân loại nghiệp vụ</a>
        <h5 class="fw-bold mb-0 mt-1">@ViewData["Title"]</h5>
    </div>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card mb-3"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1"></i>Thông tin phân loại</h6>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label small">Mã phân loại (TicketType)</label>
                <input name="Code" value="@Model.Code" class="form-control form-control-sm" placeholder="Để trống sẽ tự sinh" /></div>
            <div class="col-md-4"><label class="form-label small">Tên cho agent <span class="text-danger">*</span></label>
                <input name="AgentName" value="@Model.AgentName" class="form-control form-control-sm" placeholder="VD: Khiếu nại dịch vụ" required /></div>
            <div class="col-md-4"><label class="form-label small">Tên cho khách</label>
                <input name="CustomerName" value="@Model.CustomerName" class="form-control form-control-sm" placeholder="Để trống sẽ dùng tên agent" /></div>
            <div class="col-md-4"><label class="form-label small">Loại nghiệp vụ (BusinessType)</label>
                <select name="BusinessType" class="form-select form-select-sm">
                    @foreach (BusinessType b in Enum.GetValues<BusinessType>())
                    {<option value="@b" selected="@(Model.BusinessType==b)">@Ui.BusinessTypeName(b)</option>}
                </select></div>
            <div class="col-md-4"><label class="form-label small">Mã phân loại HO (TicketTypeHO)</label>
                <input name="HoCode" value="@Model.HoCode" class="form-control form-control-sm" /></div>
            <div class="col-md-4"><label class="form-label small">Thứ tự (Idx)</label>
                <input name="Order" value="@Model.Order" type="number" class="form-control form-control-sm" /></div>
            <div class="col-md-6"><label class="form-label small">Mẫu bố cục tạo (ScrTplCreateCodeSys)</label>
                <input name="CreateTemplate" value="@Model.CreateTemplate" class="form-control form-control-sm" /></div>
            <div class="col-md-6"><label class="form-label small">Mẫu bố cục chi tiết (ScrTplDetailCodeSys)</label>
                <input name="DetailTemplate" value="@Model.DetailTemplate" class="form-control form-control-sm" /></div>
            <div class="col-12"><label class="form-label small">Ghi chú</label>
                <textarea name="Remark" class="form-control form-control-sm" rows="2">@Model.Remark</textarea></div>
            <div class="col-12"><div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label small" for="isActive">Đang dùng (FlagActive)</label></div></div>
        </div>
    </div></div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Lưu phân loại</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy</a>
    </div>
</form>