@model List<TicketType>
@{
    ViewData["Title"] = "Phân loại nghiệp vụ";
    var stats = (TicketTypeStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var businessType = (BusinessType?)ViewBag.BusinessType;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-diagram-3 me-2"></i>Phân loại nghiệp vụ</h5>
        <small class="text-muted">Mã phân loại eTicket (Mst_TicketType) — gắn mẫu bố cục màn hình tạo/chi tiết</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Tạo phân loại</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng phân loại</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-diagram-3 fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">eTicket</div><div class="fs-3 fw-bold text-primary">@stats.ETicket</div></div>
        <i class="bi bi-ticket-detailed fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Chiến dịch</div><div class="fs-3 fw-bold text-info">@stats.Campaign</div></div>
        <i class="bi bi-megaphone fs-2 text-info opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Loại nghiệp vụ</label>
        <select name="businessType" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            @foreach (BusinessType b in Enum.GetValues<BusinessType>())
            {<option value="@b" selected="@(businessType==b)">@Ui.BusinessTypeName(b)</option>}
        </select></div>
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / tên phân loại" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Tên phân loại (agent)</th><th>Tên cho khách</th><th>Loại nghiệp vụ</th><th>Thứ tự</th><th>Trạng thái</th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có phân loại nghiệp vụ</td></tr>}
        @foreach (var t in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/TicketType/Details/@t.Id'">
                <td class="font-monospace small fw-semibold">@t.Code</td>
                <td>@t.AgentName<div class="small text-muted">@t.Remark</div></td>
                <td class="small text-muted">@t.CustomerName</td>
                <td><i class="bi @Ui.BusinessTypeIcon(t.BusinessType) me-1 text-muted"></i>@Ui.BusinessTypeBadge(t.BusinessType)</td>
                <td class="text-muted">@t.Order</td>
                <td>@if(t.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</td>
            </tr>
        }
    </tbody>
</table></div></div>