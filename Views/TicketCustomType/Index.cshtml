@model List<TicketCustomType>
@{
    ViewData["Title"] = "Loại phiếu tùy chỉnh";
    var stats = (TicketCustomTypeStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var useType = (CatalogUseType?)ViewBag.UseType;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-ticket-perforated me-2"></i>Loại phiếu tùy chỉnh</h5>
        <small class="text-muted">Phân loại con của eTicket (Mst_TicketCustomType) — gán cho từng phân loại nghiệp vụ</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm loại</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng loại</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-ticket-perforated fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-check-circle fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Agent &amp; khách</div><div class="fs-3 fw-bold text-warning">@stats.Both</div></div>
        <i class="bi bi-people fs-2 text-warning opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Lượt gán phân loại</div><div class="fs-3 fw-bold text-info">@stats.MappedTypes</div></div>
        <i class="bi bi-diagram-3 fs-2 text-info opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / tên loại" /></div>
    <div class="col-auto"><label class="form-label small mb-1">Phạm vi</label>
        <select name="useType" class="form-select form-select-sm">
            <option value="">— Tất cả —</option>
            @foreach (var t in Enum.GetValues<CatalogUseType>())
            {
                <option value="@t" selected="@(useType==t)">@Ui.CustomTypeUseTypeName(t)</option>
            }
        </select></div>
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">— Tất cả —</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Tên cho agent</th><th>Tên cho khách</th><th>Phạm vi</th><th>Phân loại áp dụng</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có loại phiếu tùy chỉnh</td></tr>}
        @foreach (var c in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/TicketCustomType/Details/@c.Id'">
                <td><span class="font-monospace small fw-semibold">@c.Code</span></td>
                <td class="fw-semibold">@c.AgentName</td>
                <td class="small text-muted">@c.CustomerName</td>
                <td>@Html.Raw(Ui.CustomTypeUseTypeBadge(c.UseType))</td>
                <td><span class="badge bg-light text-dark border">@c.MappedTypeCount phân loại</span></td>
                <td>@if(c.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm" onclick="event.stopPropagation()"><i class="bi bi-pencil me-1"></i>Sửa</a></td>
            </tr>
        }
    </tbody>
</table></div></div>