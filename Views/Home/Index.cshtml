@{
    ViewData["Title"] = "Bảng điều khiển CSKH";
    var s = (DashStats)ViewBag.Stats;
    var recent = (List<Ticket>)ViewBag.Recent;
}
<style>
    .stat{border-radius:14px}.stat .ico{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:21px}
    .stat .lbl{font-size:11.5px;text-transform:uppercase;letter-spacing:1px;color:#94a3b8;font-weight:600}.stat .val{font-size:26px;font-weight:800}
</style>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card stat h-100"><div class="card-body d-flex justify-content-between align-items-start">
        <div><div class="lbl mb-1">Phiếu mở</div><div class="val" style="color:#6d28d9">@s.Open</div></div>
        <div class="ico" style="background:#ede9fe;color:#6d28d9"><i class="bi bi-ticket-detailed"></i></div></div></div></div>
    <div class="col-md-3"><div class="card stat h-100"><div class="card-body d-flex justify-content-between align-items-start">
        <div><div class="lbl mb-1">Quá hạn SLA</div><div class="val" style="color:#e11d48">@s.Overdue</div></div>
        <div class="ico" style="background:#ffe4e6;color:#e11d48"><i class="bi bi-alarm"></i></div></div></div></div>
    <div class="col-md-3"><div class="card stat h-100"><div class="card-body d-flex justify-content-between align-items-start">
        <div><div class="lbl mb-1">Chưa gán</div><div class="val" style="color:#d97706">@s.UnassignedOpen</div></div>
        <div class="ico" style="background:#fef3c7;color:#d97706"><i class="bi bi-person-dash"></i></div></div></div></div>
    <div class="col-md-3"><div class="card stat h-100"><div class="card-body d-flex justify-content-between align-items-start">
        <div><div class="lbl mb-1">Giải quyết hôm nay</div><div class="val" style="color:#16a34a">@s.ResolvedToday</div></div>
        <div class="ico" style="background:#dcfce7;color:#16a34a"><i class="bi bi-check2-circle"></i></div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-7"><div class="card h-100"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-1"></i>Phiếu gần đây</h6>
            <a href="/Ticket" class="btn btn-outline-primary btn-sm">Xem tất cả</a></div>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Tiêu đề</th><th>Trạng thái</th><th>Ưu tiên</th></tr></thead>
            <tbody>
                @foreach (var t in recent)
                {
                    <tr style="cursor:pointer" onclick="location.href='/Ticket/Details/@t.Id'">
                        <td class="font-monospace small fw-semibold">@t.Code @if(t.IsOverdue){<i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Quá hạn"></i>}</td>
                        <td>@t.Subject<div class="small text-muted">@t.CustomerName · @Ui.ChannelName(t.Channel)</div></td>
                        <td>@Html.Raw(Ui.StatusBadge(t.Status))</td>
                        <td>@Html.Raw(Ui.PriorityBadge(t.Priority))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-5">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-diagram-2 me-1"></i>Phiếu theo trạng thái</h6>
            <canvas id="stChart" height="150"></canvas></div></div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-people me-1"></i>Tải theo agent (phiếu mở)</h6>
            @if(!s.ByAgent.Any()){<div class="text-muted small">Chưa có phiếu gán.</div>}
            @foreach (var a in s.ByAgent)
            {
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span>@a.Agent</span><span class="badge bg-primary-subtle text-primary">@a.Open</span></div>
            }
        </div></div>
    </div>
</div>

@section Scripts {
<script>
  new Chart(document.getElementById('stChart'), {
    type:'doughnut',
    data:{ labels:[@Html.Raw(string.Join(",", s.ByStatus.Keys.Select(k => $"'{Ui.StatusName(k)}'")))],
      datasets:[{ data:[@string.Join(",", s.ByStatus.Values)],
        backgroundColor:['#6d28d9','#0ea5e9','#f59e0b','#16a34a','#94a3b8','#334155'] }] },
    options:{ plugins:{ legend:{ position:'bottom' } } }
  });
</script>
}
