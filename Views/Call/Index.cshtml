@model List<CallLog>
@{
    ViewData["Title"] = "Cuộc gọi";
    var (todayTotal, missed, avgSecs) = ((int, int, int))ViewBag.Stats;
    var agents = (List<Agent>)ViewBag.Agents;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-telephone me-2"></i>Nhật ký cuộc gọi</h5>
        <small class="text-muted">@Model.Count cuộc gọi</small></div>
    <div>
        <a asp-action="WebRtc" class="btn btn-outline-success btn-sm me-1"><i class="bi bi-camera-video me-1"></i>Gọi trình duyệt (WebRTC)</a>
        <button class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#logForm"><i class="bi bi-plus-lg me-1"></i>Ghi cuộc gọi</button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Cuộc gọi hôm nay</div><div class="fs-3 fw-bold">@todayTotal</div></div>
        <i class="bi bi-telephone-fill fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Cuộc nhỡ</div><div class="fs-3 fw-bold text-danger">@missed</div></div>
        <i class="bi bi-telephone-x-fill fs-2 text-danger opacity-50"></i></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Thời lượng TB</div><div class="fs-3 fw-bold">@(avgSecs/60):@((avgSecs%60).ToString("D2"))</div></div>
        <i class="bi bi-stopwatch-fill fs-2 text-success opacity-50"></i></div></div></div>
</div>

<div class="collapse mb-3" id="logForm"><div class="card"><div class="card-body">
    <form asp-action="Log" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-md-2"><label class="form-label small mb-1">Chiều</label>
            <select name="direction" class="form-select form-select-sm">@foreach(CallDirection d in Enum.GetValues<CallDirection>()){<option value="@d">@Ui.DirName(d)</option>}</select></div>
        <div class="col-md-2"><label class="form-label small mb-1">Số điện thoại *</label><input name="phoneNumber" class="form-control form-control-sm" required /></div>
        <div class="col-md-2"><label class="form-label small mb-1">Khách hàng</label><input name="customerName" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><label class="form-label small mb-1">Agent</label>
            <select name="agentId" class="form-select form-select-sm"><option value="">—</option>@foreach(var a in agents){<option value="@a.Id">@a.Name</option>}</select></div>
        <div class="col-md-1"><label class="form-label small mb-1">Phút</label><input name="durationMinutes" type="number" min="0" value="0" class="form-control form-control-sm" /></div>
        <div class="col-md-1"><label class="form-label small mb-1">Giây</label><input name="durationSecs" type="number" min="0" max="59" value="0" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><label class="form-label small mb-1">Kết quả</label>
            <select name="outcome" class="form-select form-select-sm">@foreach(CallOutcome o in Enum.GetValues<CallOutcome>()){<option value="@o">@Ui.OutcomeName(o)</option>}</select></div>
        <div class="col-12"><input name="note" class="form-control form-control-sm" placeholder="Ghi chú nội dung cuộc gọi" /></div>
        <div class="col-12"><button class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Lưu</button></div>
    </form>
</div></div></div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Chiều</label>
        <select name="dir" class="form-select form-select-sm"><option value="">Tất cả</option>@foreach(CallDirection d in Enum.GetValues<CallDirection>()){<option value="@d" selected="@((ViewBag.Dir as CallDirection?)==d)">@Ui.DirName(d)</option>}</select></div>
    <div class="col-auto"><label class="form-label small mb-1">Kết quả</label>
        <select name="outcome" class="form-select form-select-sm"><option value="">Tất cả</option>@foreach(CallOutcome o in Enum.GetValues<CallOutcome>()){<option value="@o" selected="@((ViewBag.Outcome as CallOutcome?)==o)">@Ui.OutcomeName(o)</option>}</select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Số ĐT / khách hàng" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Chiều</th><th>Số điện thoại</th><th>Khách hàng</th><th>Agent</th><th>Thời điểm</th><th>Thời lượng</th><th>Kết quả</th><th>Ghi chú</th><th></th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có cuộc gọi</td></tr>}
        @foreach (var c in Model)
        {
            <tr>
                <td><i class="bi @Ui.DirIcon(c.Direction) me-1 @(c.Direction==CallDirection.Inbound?"text-primary":"text-success")"></i>@Ui.DirName(c.Direction)</td>
                <td class="font-monospace">@c.PhoneNumber</td>
                <td>@c.CustomerName</td>
                <td class="small">@(c.Agent?.Name ?? "—")</td>
                <td class="small text-muted">@c.StartedAt.ToString("dd/MM HH:mm")</td>
                <td class="font-monospace">@c.DurationText</td>
                <td>@Html.Raw(Ui.OutcomeBadge(c.Outcome))</td>
                <td class="small text-muted">@c.Note</td>
                <td>
                    <a href="tel:@c.PhoneNumber" class="btn btn-sm btn-outline-secondary" title="Gọi qua app điện thoại/softphone trên máy"><i class="bi bi-telephone"></i></a>
                    <button type="button" class="btn btn-sm btn-outline-primary voip-call-btn" data-phone="@c.PhoneNumber" title="Gọi VoIP thật ngay trong trình duyệt (cần cấu hình StringeeX)"><i class="bi bi-mic"></i></button>
                </td>
            </tr>
        }
    </tbody>
</table></div></div>

<div id="voip-status" class="alert d-none mt-3"></div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/stringee-js-sdk@3/dist/StringeeSdk.min.js"></script>
<script>
// Gọi VoIP thật trong trình duyệt qua StringeeX Web SDK. Cần backend đã cấu hình ENV STRINGEE_SID/STRINGEE_KEY/STRINGEE_SECRET
// (đăng ký tài khoản tại stringee.com) — nếu chưa có, nút sẽ báo lỗi rõ ràng thay vì giả vờ gọi được.
let stringeeClient = null, currentCall = null;

function showVoipStatus(msg, type) {
    const el = document.getElementById('voip-status');
    el.className = 'alert alert-' + (type || 'info') + ' mt-3';
    el.textContent = msg;
}

async function ensureStringeeClient() {
    if (stringeeClient) return stringeeClient;
    const res = await fetch('/api/v1/calls/voip-token');
    if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        throw new Error(body.error || ('Lỗi lấy token VoIP (HTTP ' + res.status + ')'));
    }
    const data = await res.json();
    stringeeClient = new StringeeClient();
    stringeeClient.connect(data.token);
    await new Promise((resolve, reject) => {
        stringeeClient.on('connect', resolve);
        stringeeClient.on('authen', (r) => { if (!r || r.r !== 0) reject(new Error('Xác thực StringeeX thất bại: ' + JSON.stringify(r))); });
        setTimeout(() => reject(new Error('Timeout kết nối StringeeX')), 10000);
    });
    return stringeeClient;
}

document.querySelectorAll('.voip-call-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
        const phone = btn.getAttribute('data-phone');
        try {
            showVoipStatus('Đang kết nối tới StringeeX để gọi ' + phone + '...', 'info');
            const client = await ensureStringeeClient();
            currentCall = new StringeeCall(client, phone, 'internal', false);
            currentCall.on('signalingstate', (s) => showVoipStatus('Trạng thái cuộc gọi tới ' + phone + ': ' + (s.reason || s.code), 'info'));
            currentCall.on('error', (e) => showVoipStatus('Lỗi cuộc gọi: ' + JSON.stringify(e), 'danger'));
            currentCall.makeCall((res) => {
                if (!res || res.r !== 0) showVoipStatus('Không thực hiện được cuộc gọi: ' + JSON.stringify(res), 'danger');
                else showVoipStatus('Đang gọi ' + phone + '...', 'success');
            });
        } catch (err) {
            showVoipStatus('Chưa dùng được VoIP thật: ' + err.message, 'warning');
        }
    });
});
</script>
}
