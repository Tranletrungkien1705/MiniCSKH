@model Ticket
@{ Layout = null; }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Gửi yêu cầu hỗ trợ</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>body{font-family:"Be Vietnam Pro",sans-serif;background:#faf9fd}.wrap{max-width:640px;margin:0 auto;padding:28px 20px 60px}
.btn-primary{background:#6d28d9;border-color:#6d28d9}.btn-primary:hover{background:#5b21b6;border-color:#5b21b6}a{color:#6d28d9}</style></head><body>
<div class="wrap">
  <a href="/Portal"><i class="bi bi-arrow-left"></i> Trung tâm hỗ trợ</a>
  <h3 class="fw-bold mt-3">Gửi yêu cầu hỗ trợ</h3>
  <p class="text-muted">Điền thông tin, đội ngũ CSKH sẽ phản hồi sớm nhất.</p>
  @if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
  <form method="post" class="card p-4 border-0 shadow-sm">
    @Html.AntiForgeryToken()
    <div class="mb-3"><label class="form-label fw-semibold">Tiêu đề vấn đề *</label><input name="Subject" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label fw-semibold">Mô tả chi tiết</label><textarea name="Description" class="form-control" rows="4"></textarea></div>
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label fw-semibold">Họ tên *</label><input name="CustomerName" class="form-control" required /></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Điện thoại</label><input name="CustomerPhone" class="form-control" /></div>
      <div class="col-12"><label class="form-label fw-semibold">Email</label><input name="CustomerEmail" type="email" class="form-control" /></div>
    </div>
    <button class="btn btn-primary mt-4"><i class="bi bi-send me-1"></i>Gửi yêu cầu</button>
  </form>
</div></body></html>
