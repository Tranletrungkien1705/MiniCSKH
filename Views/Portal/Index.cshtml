@{
    ViewData["Title"] = "Trung tâm hỗ trợ";
    Layout = null;
    var articles = (List<KbArticle>)ViewBag.Articles;
}
<!DOCTYPE html>
<html lang="vi"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Trung tâm hỗ trợ khách hàng</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  *{box-sizing:border-box}body{margin:0;font-family:"Be Vietnam Pro",-apple-system,sans-serif;color:#1e1b2e;background:#faf9fd;-webkit-font-smoothing:antialiased}
  .hero{background:linear-gradient(135deg,#6d28d9,#7c3aed);color:#fff;padding:56px 20px 64px;text-align:center}
  .hero h1{font-size:clamp(1.6rem,4vw,2.4rem);font-weight:800;margin:0 0 10px}
  .hero p{opacity:.9;margin:0 0 24px}
  .search{max-width:620px;margin:0 auto;display:flex;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 12px 30px rgba(0,0,0,.2)}
  .search input{flex:1;border:none;padding:15px 18px;font:inherit;font-size:15px;outline:none}
  .search button{border:none;background:#5b21b6;color:#fff;padding:0 22px;font-weight:600;cursor:pointer}
  .wrap{max-width:900px;margin:-32px auto 60px;padding:0 20px}
  .card{background:#fff;border:1px solid #eee;border-radius:14px;padding:18px 20px;margin-bottom:14px;transition:.15s;text-decoration:none;color:inherit;display:block}
  .card:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(2,6,23,.08)}
  .tag{font-size:12px;font-weight:600;color:#6d28d9;background:#ede9fe;padding:3px 10px;border-radius:20px}
  .cta{text-align:center;margin:34px 0}
  .btn{display:inline-flex;align-items:center;gap:8px;background:#6d28d9;color:#fff;text-decoration:none;padding:13px 26px;border-radius:11px;font-weight:600}
  h2{font-size:1.15rem;margin:26px 0 12px}
</style></head><body>
<div class="hero">
  <h1>Chúng tôi có thể giúp gì cho bạn?</h1>
  <p>Tra cứu hướng dẫn hoặc gửi yêu cầu hỗ trợ tới đội ngũ CSKH</p>
  <form class="search" method="get" action="/Portal">
    <input name="q" value="@ViewBag.Q" placeholder="Tìm câu hỏi, hướng dẫn…" />
    <button><i class="bi bi-search"></i></button>
  </form>
</div>
<div class="wrap">
  <div class="cta"><a class="btn" href="/Portal/NewTicket"><i class="bi bi-plus-circle"></i> Gửi yêu cầu hỗ trợ</a></div>
  <h2><i class="bi bi-journal-richtext me-1"></i>Bài viết hữu ích</h2>
  @if(!articles.Any()){<div class="text-muted">Không tìm thấy bài viết phù hợp.</div>}
  @foreach (var a in articles)
  {
    <a class="card" href="/Portal/Article/@a.Id">
      <span class="tag">@a.Category</span>
      <div style="font-weight:700;margin:8px 0 4px">@a.Title</div>
      <div style="color:#6b7280;font-size:14px">@(a.Body.Length>110?a.Body[..110]+"…":a.Body)</div>
    </a>
  }
</div>
</body></html>
