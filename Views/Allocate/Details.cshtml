@model AllocateRule
@{
    ViewData["Title"] = "Chi tiết thiết lập phân bổ";
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Phân bổ phiếu tự động</a>
        <h5 class="fw-bold mb-1 mt-1">Phòng ban <span class="font-monospace">@Model.DepartmentCode</span>
            @if(Model.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}
            else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</h5>
        <div class="text-muted small">@Html.Raw(Ui.AllocateModeBadge(Model)) · tạo @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Sửa</a>
        <form asp-action="Toggle" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-sm @(Model.IsActive?"btn-outline-secondary":"btn-primary")">
                <i class="bi bi-toggle-@(Model.IsActive?"off":"on") me-1"></i>@(Model.IsActive?"Ngừng dùng":"Kích hoạt")</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Phòng ban</div><div class="fs-5 fw-bold font-monospace">@Model.DepartmentCode</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Chia đều</div><div class="fs-5 fw-bold">@(Model.AllocateEven ? "Có" : "Không")</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Tự gán agent</div><div class="fs-5 fw-bold">@(Model.AssignAgent ? "Có" : "Không")</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Cuộc gọi nhỡ</div><div class="fs-5 fw-bold">@(Model.AllMissedCall ? "Có gán" : "Không")</div></div></div></div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Remark))
{
    <div class="alert alert-light border"><i class="bi bi-info-circle me-1"></i>@Model.Remark</div>
}

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-people me-1"></i>Agent nhận phiếu (@Model.AgentCount)</h6>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th style="width:50px">#</th><th>Mã agent</th><th>Ghi chú</th><th>Trạng thái</th></tr></thead>
        <tbody>
            @if(!Model.Agents.Any()){<tr><td colspan="4" class="text-center text-muted py-4">Chưa cấu hình agent nhận phiếu</td></tr>}
            @{ var idx = 0; }
            @foreach (var a in Model.Agents)
            {
                idx++;
                <tr>
                    <td class="text-muted">@idx</td>
                    <td class="font-monospace small fw-semibold">@a.AgentCode</td>
                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(a.Remark) ? "—" : a.Remark)</td>
                    <td>@if(a.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Tắt</span>}</td>
                </tr>
            }
        </tbody>
    </table></div>
</div></div>
