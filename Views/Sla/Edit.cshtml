@model SlaPolicy
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm mức SLA" : $"Sửa SLA {Model.Code}";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-stopwatch me-2"></i>@ViewData["Title"]</h5>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Mã SLA</label>
                        <input asp-for="Code" class="form-control form-control-sm" placeholder="Để trống sẽ tự sinh" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small mb-1">Mức SLA *</label>
                        <input asp-for="Level" class="form-control form-control-sm" placeholder="VD: VIP / Khẩn cấp" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Thời gian phản hồi đầu tiên (phút) *</label>
                        <input asp-for="FirstResMinutes" type="number" min="1" class="form-control form-control-sm" required />
                        <div class="form-text">Cam kết phản hồi khách trong bao lâu kể từ khi tiếp nhận.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Thời gian xử lý (phút) *</label>
                        <input asp-for="ResolutionMinutes" type="number" min="1" class="form-control form-control-sm" required />
                        <div class="form-text">Cam kết giải quyết xong phiếu.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-1">Mô tả</label>
                        <textarea asp-for="Description" class="form-control form-control-sm" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label small" asp-for="IsActive">Đang áp dụng</label>
                        </div>
                    </div>
                </div>
                <button class="btn btn-primary btn-sm mt-3"><i class="bi bi-check-lg me-1"></i>Lưu</button>
            </form>
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <div class="text-muted small text-uppercase mb-2"><i class="bi bi-info-circle me-1"></i>Gợi ý mức SLA</div>
            <ul class="small mb-0 ps-3">
                <li><b>VIP / Khẩn cấp</b>: phản hồi 15 phút, xử lý 4 giờ.</li>
                <li><b>Tiêu chuẩn</b>: phản hồi 60 phút, xử lý 8 giờ.</li>
                <li><b>Thấp / Tư vấn</b>: phản hồi 4 giờ, xử lý 2 ngày.</li>
            </ul>
            <hr />
            <div class="small text-muted">Phiếu gắn mức SLA sẽ được đối chiếu thời gian phản hồi/xử lý thực tế để phát hiện vi phạm cam kết.</div>
        </div></div>
    </div>
</div>
