@model Sla
@{
    ViewData["Title"] = (string)ViewBag.PageTitle;
    var bizHours = (List<BizHour>)ViewBag.BizHours;
    // EditSLA.cshtml:63 — nguồn hard-code đúng 3 mức A/B/C, KHÔNG lấy từ bảng
    var levelList = new List<string> { "A", "B", "C" };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h5 fw-bold mb-0"><i class="bi bi-speedometer me-2"></i>@ViewBag.PageTitle
        <span class="text-muted fw-normal" style="font-size:12px">(port 1:1 EditSLA.cshtml — SLA)</span></h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
</div>

<form method="post"><div class="card"><div class="card-body">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />   @* EditSLA.cshtml:45 *@
    <div class="row g-3">
        @* EditSLA.cshtml:56-69 — Level *@
        <div class="col-md-4"><label class="form-label fw-semibold">Level <span class="text-danger">*</span></label>
            <select name="Level" class="form-select" required>
                @foreach (var l in levelList)
                {
                    <option value="@l" selected="@(Model.Level == l)">@l</option>
                }
            </select></div>

        @* EditSLA.cshtml:75-80 — FirstResponseTime, widget html-duration-picker nhập "HH:mm" *@
        <div class="col-md-4"><label class="form-label fw-semibold">Thời gian phản hồi đầu (giờ:phút)</label>
            <input name="firstResponseTimeDesc" value="@Model.FirstResponseTimeDesc" class="form-control"
                   pattern="[0-9]{1,3}:[0-5][0-9]" placeholder="08:00" required /></div>

        @* EditSLA.cshtml:84-88 — Business Hour, nguồn nạp bằng AJAX Organization/GetBusinessHours *@
        <div class="col-md-4"><label class="form-label fw-semibold">Khung giờ làm việc</label>
            <select name="BusinessHourId" class="form-select">
                <option value="0">— Chọn —</option>
                @foreach (var h in bizHours)
                {
                    <option value="@h.Id" selected="@(Model.BusinessHourId == h.Id)">@h.Name</option>
                }
            </select></div>

        @* EditSLA.cshtml:96-100 — EveryResponseTime *@
        <div class="col-md-4"><label class="form-label fw-semibold">Thời gian mỗi phản hồi (giờ:phút)</label>
            <input name="everyResponseTimeDesc" value="@Model.EveryResponseTimeDesc" class="form-control"
                   pattern="[0-9]{1,3}:[0-5][0-9]" placeholder="04:00" required /></div>

        @* EditSLA.cshtml:105-109 — Description *@
        <div class="col-md-4"><label class="form-label fw-semibold">Mô tả <span class="text-danger">*</span></label>
            <input name="Description" value="@Model.Description" class="form-control" required /></div>

        @* EditSLA.cshtml:114-118 — ResolutionTime *@
        <div class="col-md-4"><label class="form-label fw-semibold">Thời gian hoàn tất (giờ:phút)</label>
            <input name="resolutionTimeDesc" value="@Model.ResolutionTimeDesc" class="form-control"
                   pattern="[0-9]{1,3}:[0-5][0-9]" placeholder="24:00" required /></div>

        @* EditSLA.cshtml:123-129 — IsActive (custom-switch) *@
        <div class="col-md-4"><label class="form-label fw-semibold d-block">Đang áp dụng</label>
            <div class="form-check form-switch">
                <input type="hidden" name="IsActive" value="false" />
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="sw_active" checked="@Model.IsActive" />
                <label class="form-check-label" for="sw_active">Active</label>
            </div></div>
    </div>

    @* ─────────────────────────────────────────────────────────────────────────────────
       EditSLA.cshtml:136-185 — khối "Applying Conditions" (AND / OR) là bộ dựng điều kiện
       định tuyến động: nguồn render bằng partial RoutingConditionScripts + window.init_routing_conditions,
       rồi gom thành JSON gửi lên 2 trường ANDConditionDetails / ORConditionDetails (EditSLA.cshtml:271-272).
       Đích port ĐÚNG HAI CỘT đó dưới dạng JSON thô (textarea) — CỐ Ý ĐƠN GIẢN HOÁ phần dựng UI,
       KHÔNG bỏ cột. Cấu trúc 1 phần tử: {ObjectType, Field, Operator, Value} (nguồn Models/RoutingConditions.cs).
       ───────────────────────────────────────────────────────────────────────────────── *@
    <hr class="my-4" />
    <div class="mb-2 text-uppercase small fw-bold text-muted">Điều kiện áp dụng</div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-semibold">Điều kiện AND (JSON)</label>
            <textarea name="ANDConditionDetails" class="form-control font-monospace" rows="4"
                      placeholder='[{"ObjectType":"Conversation","Field":"PriorityId","Operator":"Equal","Value":"4"}]'>@Model.ANDConditionDetails</textarea></div>
        <div class="col-md-6"><label class="form-label fw-semibold">Điều kiện OR (JSON)</label>
            <textarea name="ORConditionDetails" class="form-control font-monospace" rows="4">@Model.ORConditionDetails</textarea></div>
    </div>

    @* EditSLA.cshtml:48-49 — hai nút Save / Cancel *@
    <div class="mt-3">
        <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu</button>
        <a asp-action="Index" class="btn btn-light">Hủy</a>
    </div>
</div></div></form>
