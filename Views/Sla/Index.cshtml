@model List<Sla>
@{
    ViewData["Title"] = "SLA";
}
@* Cột hiển thị bám đúng SLAs.cshtml:28-34 — Id / Level / Description / Status (+ ô thao tác sửa-xóa) *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h5 fw-bold mb-0"><i class="bi bi-speedometer me-2"></i>SLA
            <span class="text-muted fw-normal" style="font-size:12px">(port 1:1 SLAs.cshtml — SLA)</span></h1>
        <small class="text-muted">@Model.Count cam kết · thời gian tính theo giờ:phút</small>
    </div>
    <a asp-action="Edit" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm SLA</a>
</div>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr>
        <th style="width:80px"></th><th>Id</th><th>Level</th><th>Mô tả</th>
        <th>Phản hồi đầu</th><th>Mỗi phản hồi</th><th>Hoàn tất</th><th>Trạng thái</th>
    </tr></thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có SLA</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @* SLAs.cshtml:43-49 — mỗi dòng có 1 nút xóa và 1 nút sửa *@
                    <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline"
                          onsubmit="return confirm('Xóa SLA này?')">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-link btn-sm text-danger p-0 me-2" title="Xóa"><i class="bi bi-trash"></i></button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@item.Id" title="Sửa"><i class="bi bi-pencil"></i></a>
                </td>
                <td class="font-monospace small">@item.Id</td>
                <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@item.Level</span></td>
                <td class="fw-semibold">@item.Description</td>
                <td class="small font-monospace">@item.FirstResponseTimeDesc</td>
                <td class="small font-monospace">@item.EveryResponseTimeDesc</td>
                <td class="small font-monospace">@item.ResolutionTimeDesc</td>
                @* SLAs.cshtml:59-61 — nguồn in thẳng chữ Active/Inactive theo IsActive *@
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table></div></div>
