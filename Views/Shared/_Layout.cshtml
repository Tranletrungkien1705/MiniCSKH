<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MiniCSKH</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root { --accent:#6d28d9; --accent2:#5b21b6; --sidebar:#1e1b2e; }
        body { font-size:14px; background:#f4f4f8; font-family:"Be Vietnam Pro",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; -webkit-font-smoothing:antialiased; }
        .sidebar { width:230px; min-height:100vh; background:var(--sidebar); flex-shrink:0; }
        .sidebar .brand { color:#fff; font-weight:800; font-size:18px; padding:20px 18px 12px; display:flex; align-items:center; gap:9px; }
        .sidebar .brand span { color:#a78bfa; }
        .sidebar .nav-link { color:#a5a1b8; padding:9px 18px; display:flex; align-items:center; gap:10px; font-size:14px; transition:.15s; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color:#fff; background:rgba(109,40,217,.28); border-left:3px solid var(--accent); }
        .sidebar .nav-section { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#544f6e; padding:14px 18px 4px; }
        .topbar { background:#fff; border-bottom:1px solid #e5e5ee; padding:11px 24px; }
        .content-area { padding:24px; }
        .card { border:none; box-shadow:0 1px 4px rgba(2,6,23,.06); border-radius:13px; }
        .btn-primary { background:var(--accent); border-color:var(--accent); } .btn-primary:hover { background:var(--accent2); border-color:var(--accent2); }
        .btn-outline-primary { color:var(--accent); border-color:var(--accent); } .btn-outline-primary:hover { background:var(--accent); border-color:var(--accent); }
        a { color:var(--accent2); }
        table th { font-size:11.5px; text-transform:uppercase; letter-spacing:.4px; color:#6b7280; border-bottom:2px solid #e5e7eb; }
    </style>
</head>
<body>
<div class="d-flex">
    <nav class="sidebar d-flex flex-column">
        <div class="brand"><i class="bi bi-headset"></i> Mini<span>CSKH</span></div>
        <div class="mt-1">
            <div class="nav-section">Tổng quan</div>
            <a class="nav-link @(Nav("Home","Index"))" href="/"><i class="bi bi-speedometer2"></i> Bảng điều khiển</a>
            <div class="nav-section">Hỗ trợ</div>
            <a class="nav-link @(Nav("Customer","Index"))" href="/Customer"><i class="bi bi-people"></i> Khách hàng</a>
            <a class="nav-link @(Nav("Taxpayer","Index"))" href="/Taxpayer"><i class="bi bi-receipt"></i> Người nộp thuế</a>
            <a class="nav-link @(Nav("Ticket","Index"))" href="/Ticket"><i class="bi bi-ticket-detailed"></i> Phiếu hỗ trợ</a>
            <a class="nav-link @(Nav("Ticket","Create"))" href="/Ticket/Create"><i class="bi bi-plus-square"></i> Tạo phiếu</a>
            <a class="nav-link @(Nav("TicketType","Index"))" href="/TicketType"><i class="bi bi-diagram-3"></i> Phân loại nghiệp vụ</a>
            <a class="nav-link @(Nav("TicketCatalog","Index"))" href="/TicketCatalog"><i class="bi bi-tags"></i> Danh mục phiếu</a>
            <a class="nav-link @(Nav("ContactChannel","Index"))" href="/ContactChannel"><i class="bi bi-chat-dots"></i> Kênh liên hệ</a>
            <a class="nav-link @(Nav("ChannelType","Index"))" href="/ChannelType"><i class="bi bi-broadcast"></i> Loại kênh</a>
            <a class="nav-link @(Nav("TicketCustomType","Index"))" href="/TicketCustomType"><i class="bi bi-ticket-perforated"></i> Loại phiếu tùy chỉnh</a>
            <a class="nav-link @(Nav("GovIDType","Index"))" href="/GovIDType"><i class="bi bi-person-vcard"></i> Loại giấy tờ định danh</a>
            <a class="nav-link @(Nav("Department","Index"))" href="/Department"><i class="bi bi-diagram-2"></i> Phòng ban</a>
            <a class="nav-link @(Nav("TicketTypeDepartment","Index"))" href="/TicketTypeDepartment"><i class="bi bi-diagram-3"></i> Gán loại phiếu — phòng ban</a>
            <a class="nav-link @(Nav("PaymentTerm","Index"))" href="/PaymentTerm"><i class="bi bi-credit-card"></i> Điều khoản thanh toán</a>
            <a class="nav-link @(Nav("Area","Index"))" href="/Area"><i class="bi bi-geo-alt"></i> Vùng thị trường</a>
            <a class="nav-link @(Nav("Address","Index"))" href="/Address"><i class="bi bi-geo"></i> Danh mục địa chỉ</a>
            <a class="nav-link @(Nav("Country","Index"))" href="/Country"><i class="bi bi-globe"></i> Quốc gia</a>
            <a class="nav-link @(Nav("SatisfactionRating","Index"))" href="/SatisfactionRating"><i class="bi bi-emoji-smile"></i> Mức đánh giá hài lòng</a>
            <a class="nav-link @(Nav("Tag","Index"))" href="/Tag"><i class="bi bi-tags-fill"></i> Thẻ</a>
            <a class="nav-link @(Nav("Call","Index"))" href="/Call"><i class="bi bi-telephone"></i> Cuộc gọi</a>
            <a class="nav-link @(Nav("Campaign","Index"))" href="/Campaign"><i class="bi bi-megaphone"></i> Chiến dịch</a>
            <a class="nav-link @(Nav("CampaignType","Index"))" href="/CampaignType"><i class="bi bi-megaphone-fill"></i> Loại chiến dịch</a>
            <a class="nav-link @(Nav("Sla","Index"))" href="/Sla"><i class="bi bi-stopwatch"></i> Chính sách SLA</a>
            <a class="nav-link @(Nav("SlaCalendar","Index"))" href="/SlaCalendar"><i class="bi bi-calendar-week"></i> Lịch làm việc SLA</a>
            <a class="nav-link @(Nav("SlaScope","Index"))" href="/SlaScope"><i class="bi bi-funnel"></i> Điều kiện áp dụng SLA</a>
            <a class="nav-link @(Nav("Rating","Index"))" href="/Rating"><i class="bi bi-star"></i> Đánh giá phiếu</a>
            <a class="nav-link @(Nav("Survey","Index"))" href="/Survey"><i class="bi bi-clipboard-check"></i> Mẫu khảo sát</a>
            <a class="nav-link @(Nav("SvImprv","Index"))" href="/SvImprv"><i class="bi bi-graph-up-arrow"></i> Cải tiến chất lượng</a>
            <a class="nav-link @(Nav("Allocate","Index"))" href="/Allocate"><i class="bi bi-shuffle"></i> Phân bổ phiếu</a>
            <a class="nav-link @(Nav("Reminder","Index"))" href="/Reminder"><i class="bi bi-bell"></i> Nhắc nhở phiếu</a>
            <a class="nav-link @(Nav("ReceiveNotify","Index"))" href="/ReceiveNotify"><i class="bi bi-bell-fill"></i> Người nhận thông báo</a>
            <div class="nav-section">Tri thức</div>
            <a class="nav-link @(Nav("Kb","Index"))" href="/Kb"><i class="bi bi-journal-richtext"></i> Knowledge Base</a>
            <a class="nav-link" href="/Portal" target="_blank"><i class="bi bi-box-arrow-up-right"></i> Cổng khách hàng</a>
            <div class="nav-section">Hệ thống</div>
            <a class="nav-link @(Nav("Org","Index"))" href="/Org"><i class="bi bi-building"></i> Tổ chức</a>
        </div>
        <div class="mt-auto p-3" style="color:#544f6e;font-size:11px">CSKH đa kênh · eTicket · demo</div>
    </nav>
    <div class="main-content flex-fill" style="overflow-x:hidden">
        <div class="topbar d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-bold">@ViewData["Title"]</h6>
            <a href="/Org" class="text-muted small text-decoration-none"><i class="bi bi-building me-1"></i>@(Context.Request.Cookies["org_name"] ?? "Demo CSKH") <i class="bi bi-chevron-down ms-1" style="font-size:10px"></i></a>
        </div>
        <div class="content-area">
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    string Nav(string c, string a)
    {
        var cc = ViewContext.RouteData.Values["controller"]?.ToString();
        var ca = ViewContext.RouteData.Values["action"]?.ToString();
        return cc == c && ca == a ? "active" : "";
    }
}
