@model TicketRating
@{
    ViewData["Title"] = "Kiểm soát đánh giá";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-shield-check me-2"></i>Kiểm soát đánh giá</h5>
        <small class="text-muted">Phiếu @Model.Ticket.Code — @Model.Ticket.Subject</small></div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card"><div class="card-body">
            <div class="text-muted small text-uppercase mb-2">Đánh giá của khách</div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-warning fs-5">@Model.Stars</span>
                @Html.Raw(Ui.RateResultBadge(Model.Result))
            </div>
            <div class="small">Người đánh giá: <b>@Model.RatedBy</b></div>
            <div class="small">Thời điểm: @Model.RatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="small">Lần đánh giá: #@Model.RateRound · Mẫu: <span class="font-monospace">@Model.FormCode</span></div>
            @if(!string.IsNullOrEmpty(Model.Comment)){<div class="p-2 mt-2 rounded" style="background:#f8f7fc">@Model.Comment</div>}
        </div></div>
    </div>

    <div class="col-lg-6">
        <div class="card"><div class="card-body">
            <form asp-action="Review" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold">Agent kiểm soát</label>
                    <input name="reviewedBy" class="form-control" value="Agent" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ghi chú kiểm soát</label>
                    <textarea name="reviewNote" class="form-control" rows="4" placeholder="Nhận xét nội bộ về đánh giá này…">@Model.ReviewNote</textarea>
                </div>
                <button class="btn btn-primary"><i class="bi bi-check2-all me-1"></i>Xác nhận kiểm soát</button>
            </form>
        </div></div>
    </div>
</div>
