@model Area
@{
    ViewData["Title"] = "Chi tiết vùng thị trường";
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Vùng thị trường</a>
        <h5 class="fw-bold mb-1 mt-1">@Model.Name <span class="font-monospace text-muted">@Model.Code</span>
            @Html.Raw(Ui.AreaLevelBadge(Model.Level))
            @if(Model.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}
            else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</h5>
        <div class="text-muted small">tạo @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") · cập nhật @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Sửa</a>
        <form asp-action="Toggle" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-sm @(Model.IsActive?"btn-outline-secondary":"btn-primary")">
                <i class="bi bi-toggle-@(Model.IsActive?"off":"on") me-1"></i>@(Model.IsActive?"Ngừng dùng":"Kích hoạt")</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Cấp vùng</div><div class="fs-6 fw-bold">@Model.LevelName</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Vùng cấp trên</div><div class="fs-6 fw-bold">@(string.IsNullOrWhiteSpace(Model.ParentCode) ? "— (vùng gốc)" : Model.ParentCode)</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Đơn vị kinh doanh</div><div class="fs-6 fw-bold">@(string.IsNullOrWhiteSpace(Model.BUCode) ? "—" : Model.BUCode)</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Mẫu đơn vị KD</div><div class="fs-6 fw-bold">@(string.IsNullOrWhiteSpace(Model.BUPattern) ? "—" : Model.BUPattern)</div></div></div></div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <div class="alert alert-light border">
        <div><i class="bi bi-info-circle me-1"></i>@Model.Description</div>
    </div>
}