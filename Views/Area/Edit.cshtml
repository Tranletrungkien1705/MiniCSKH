@model Area
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm vùng thị trường" : "Sửa vùng thị trường";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Vùng thị trường</a>
        <h5 class="fw-bold mb-0 mt-1">@ViewData["Title"]</h5>
    </div>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card mb-3"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1"></i>Thông tin vùng thị trường</h6>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label small">Mã vùng (AreaCode) <span class="text-danger">*</span></label>
                <input name="Code" value="@Model.Code" class="form-control form-control-sm" placeholder="VD: MB" required />
                <div class="form-text">Để trống sẽ tự sinh mã.</div></div>
            <div class="col-md-4"><label class="form-label small">Tên vùng (AreaName) <span class="text-danger">*</span></label>
                <input name="Name" value="@Model.Name" class="form-control form-control-sm" placeholder="VD: Miền Bắc" required /></div>
            <div class="col-md-4"><label class="form-label small">Cấp vùng (AreaLevel) <span class="text-danger">*</span></label>
                <input name="Level" type="number" min="1" value="@Model.Level" class="form-control form-control-sm" /></div>
            <div class="col-md-4"><label class="form-label small">Vùng cấp trên (AreaCodeParent)</label>
                <input name="ParentCode" value="@Model.ParentCode" class="form-control form-control-sm" placeholder="Để trống nếu là vùng gốc" /></div>
            <div class="col-md-4"><label class="form-label small">Đơn vị kinh doanh (AreaBUCode)</label>
                <input name="BUCode" value="@Model.BUCode" class="form-control form-control-sm" placeholder="Mã đơn vị kinh doanh" /></div>
            <div class="col-md-4"><label class="form-label small">Mẫu đơn vị KD (AreaBUPattern)</label>
                <input name="BUPattern" value="@Model.BUPattern" class="form-control form-control-sm" placeholder="Mẫu đơn vị kinh doanh" /></div>
            <div class="col-12"><label class="form-label small">Mô tả (AreaDesc)</label>
                <input name="Description" value="@Model.Description" class="form-control form-control-sm" placeholder="Mô tả vùng thị trường" /></div>
            <div class="col-12"><div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label small" for="isActive">Đang dùng (FlagActive)</label></div></div>
        </div>
    </div></div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Lưu vùng</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy</a>
    </div>
</form>