@model List<SlaPolicy>
@{
    ViewData["Title"] = "Điều kiện áp dụng SLA";
    var stats = (SlaScopeStats)ViewBag.Stats;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-funnel me-2"></i>Điều kiện áp dụng SLA</h5>
        <small class="text-muted">Gán chính sách SLA cho loại phiếu / khách hàng / nhóm khách (Mst_SLATicketType, Mst_SLACustomerCN, …)</small></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Chính sách SLA</div><div class="fs-3 fw-bold">@stats.Policies</div></div>
        <i class="bi bi-stopwatch fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Có đối tượng áp dụng</div><div class="fs-3 fw-bold text-success">@stats.WithScopes</div></div>
        <i class="bi bi-check-circle fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Bật "tất cả"</div><div class="fs-3 fw-bold text-warning">@stats.AllFlagPolicies</div></div>
        <i class="bi bi-asterisk fs-2 text-warning opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Dòng đối tượng</div><div class="fs-3 fw-bold text-info">@stats.ScopeRows</div></div>
        <i class="bi bi-list-check fs-2 text-info opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / mức SLA" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã SLA</th><th>Mức SLA</th><th>Cam kết</th><th>Phạm vi áp dụng</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có chính sách SLA</td></tr>}
        @foreach (var p in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/SlaScope/Details/@p.Id'">
                <td><span class="font-monospace small fw-semibold">@p.Code</span></td>
                <td class="fw-semibold">@p.Level</td>
                <td class="small text-muted">PH @p.FirstResText · XL @p.ResolutionText</td>
                <td>
                    @if(p.AllFlagCount > 0){<span class="badge bg-warning-subtle text-warning border-warning-subtle me-1"><i class="bi bi-asterisk me-1"></i>@p.AllFlagCount nhóm "tất cả"</span>}
                    <span class="badge bg-light text-dark border">@p.ScopeCount đối tượng</span>
                </td>
                <td>@if(p.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm" onclick="event.stopPropagation()"><i class="bi bi-pencil me-1"></i>Sửa</a></td>
            </tr>
        }
    </tbody>
</table></div></div>