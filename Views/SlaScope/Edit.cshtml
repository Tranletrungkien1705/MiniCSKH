@model SlaPolicy
@{
    ViewData["Title"] = "Sửa điều kiện áp dụng SLA";
    var scopes = Model.Scopes.ToList();
    if (scopes.Count == 0) scopes.Add(new SlaScope());
    var allFlags = new (string Field, string Name, bool On)[]
    {
        ("AllTicketType", "Loại phiếu", Model.AllTicketType),
        ("AllTicketCustomType", "Loại phiếu tùy chỉnh", Model.AllTicketCustomType),
        ("AllCustomerCN", "Khách hàng cá nhân", Model.AllCustomerCN),
        ("AllCustomerGroupCN", "Nhóm khách cá nhân", Model.AllCustomerGroupCN),
        ("AllCustomerDN", "Khách hàng doanh nghiệp", Model.AllCustomerDN),
        ("AllCustomerGroupDN", "Nhóm khách doanh nghiệp", Model.AllCustomerGroupDN)
    };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Điều kiện áp dụng SLA</a>
        <h5 class="fw-bold mb-0 mt-1">@ViewData["Title"] — <span class="font-monospace">@Model.Code</span></h5>
    </div>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card mb-3"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-asterisk me-1"></i>Áp dụng cho tất cả (Mst_SLA.FlagAll*)</h6>
        <div class="row g-3">
            @foreach (var f in allFlags)
            {
                <div class="col-md-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="@f.Field" value="true" id="f_@f.Field" @(f.On ? "checked" : "") />
                        <label class="form-check-label small" for="f_@f.Field">@f.Name</label>
                    </div>
                </div>
            }
        </div>
        <div class="small text-muted mt-2"><i class="bi bi-info-circle me-1"></i>Bật cờ để chính sách áp dụng cho mọi đối tượng thuộc nhóm đó (không cần liệt kê chi tiết bên dưới).</div>
    </div></div>

    <div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0"><i class="bi bi-list-check me-1"></i>Đối tượng áp dụng cụ thể</h6>
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="addRow()"><i class="bi bi-plus-lg me-1"></i>Thêm đối tượng</button>
        </div>
        <div class="table-responsive"><table class="table align-middle mb-0" id="scopeTable">
            <thead><tr><th style="width:35%">Loại đối tượng</th><th style="width:55%">Mã đối tượng</th><th style="width:40px"></th></tr></thead>
            <tbody>
                @foreach (var s in scopes)
                {
                    <tr>
                        <td>
                            <select name="scopeKind" class="form-select form-select-sm">
                                @foreach (var k in Enum.GetValues<SlaScopeKind>())
                                {
                                    <option value="@k" selected="@(s.Kind==k)">@Ui.SlaScopeKindName(k)</option>
                                }
                            </select>
                        </td>
                        <td><input name="scopeCode" value="@s.RefCode" class="form-control form-control-sm" placeholder="VD: TT-SUPPORT / KH0001 / GRP-VIP" /></td>
                        <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>
                    </tr>
                }
            </tbody>
        </table></div>
        <div class="small text-muted mt-2"><i class="bi bi-info-circle me-1"></i>Mã đối tượng theo loại: loại phiếu = TicketType (Mst_TicketType), loại tùy chỉnh = TicketCustomType, khách hàng = CustomerCodeSys, nhóm khách = CustomerGrpCode.</div>
    </div></div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Lưu điều kiện áp dụng</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy</a>
    </div>
</form>

@section Scripts {
<script>
    const kindOptions = `@Html.Raw(string.Join("", Enum.GetValues<SlaScopeKind>().Select(k => $"<option value=\"{k}\">{Ui.SlaScopeKindName(k)}</option>")))`;
    function addRow() {
        const tb = document.querySelector('#scopeTable tbody');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><select name="scopeKind" class="form-select form-select-sm">${kindOptions}</select></td>
            <td><input name="scopeCode" class="form-control form-control-sm" placeholder="VD: TT-SUPPORT / KH0001 / GRP-VIP" /></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>`;
        tb.appendChild(tr);
    }
</script>
}