@model SatisfactionRating
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm mức đánh giá hài lòng" : "Sửa mức đánh giá hài lòng";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Mức đánh giá hài lòng</a>
        <h5 class="fw-bold mb-0 mt-1">@ViewData["Title"]</h5>
    </div>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card mb-3"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1"></i>Thông tin mức đánh giá</h6>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label small">Mã mức đánh giá (SatRatingCode)</label>
                <input name="Code" value="@Model.Code" class="form-control form-control-sm" placeholder="VD: SAT5 / SAT4 / SAT3" />
                <div class="form-text">Để trống sẽ tự sinh mã.</div></div>
            <div class="col-md-4"><label class="form-label small">Tên mức đánh giá (SatRatingName) <span class="text-danger">*</span></label>
                <input name="Name" value="@Model.Name" class="form-control form-control-sm" placeholder="VD: Rất hài lòng" required /></div>
            <div class="col-md-4"><label class="form-label small">Thứ tự hiển thị (OrdIdx)</label>
                <input name="Order" value="@Model.Order" type="number" class="form-control form-control-sm" placeholder="VD: 1" /></div>
            <div class="col-12"><label class="form-label small">Ghi chú (Remark)</label>
                <input name="Remark" value="@Model.Remark" class="form-control form-control-sm" placeholder="Mô tả ngắn về mức đánh giá" /></div>
            <div class="col-12"><div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label small" for="isActive">Đang dùng (FlagActive)</label></div></div>
        </div>
    </div></div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Lưu mức đánh giá</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy</a>
    </div>
</form>
