@model SatisfactionRating
@{
    ViewData["Title"] = "Chi tiết mức đánh giá hài lòng";
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Mức đánh giá hài lòng</a>
        <h5 class="fw-bold mb-1 mt-1"><i class="bi @Ui.SatRatingIcon(Model.Code) me-1"></i>@Model.Name <span class="font-monospace text-muted">@Model.Code</span>
            @Html.Raw(Ui.SatRatingActiveBadge(Model.IsActive))</h5>
        <div class="text-muted small">tạo @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") · cập nhật @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Sửa</a>
        <form asp-action="Toggle" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-sm @(Model.IsActive?"btn-outline-secondary":"btn-primary")">
                <i class="bi bi-toggle-@(Model.IsActive?"off":"on") me-1"></i>@(Model.IsActive?"Ngừng dùng":"Kích hoạt")</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Mã (SatRatingCode)</div><div class="fs-5 fw-bold font-monospace">@Model.Code</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Tên (SatRatingName)</div><div class="fs-6 fw-bold">@Model.Name</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Thứ tự (OrdIdx)</div><div class="fs-6 fw-bold">@Model.Order</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Trạng thái (FlagActive)</div>
        <div class="fs-6 fw-bold">@Html.Raw(Ui.SatRatingActiveBadge(Model.IsActive))</div></div></div></div>
</div>

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-emoji-smile me-1"></i>Thông tin mức đánh giá</h6>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>Thuộc tính</th><th>Giá trị</th></tr></thead>
        <tbody>
            <tr><td><i class="bi bi-upc me-1"></i>Mã (SatRatingCode)</td><td class="font-monospace">@Model.Code</td></tr>
            <tr><td><i class="bi bi-tag me-1"></i>Tên (SatRatingName)</td><td>@Model.Name</td></tr>
            <tr><td><i class="bi bi-sort-numeric-down me-1"></i>Thứ tự (OrdIdx)</td><td>@Model.Order</td></tr>
            <tr><td><i class="bi bi-star me-1"></i>Mức độ</td><td>@Html.Raw(Ui.SatRatingBadge(Model.Code))</td></tr>
            <tr><td><i class="bi bi-chat-left-text me-1"></i>Ghi chú (Remark)</td><td>@(string.IsNullOrWhiteSpace(Model.Remark) ? "—" : Model.Remark)</td></tr>
            <tr><td><i class="bi bi-toggle-on me-1"></i>Trạng thái (FlagActive)</td><td>@Html.Raw(Ui.SatRatingActiveBadge(Model.IsActive))</td></tr>
            <tr><td><i class="bi bi-person me-1"></i>Người tạo (LogLUBy)</td><td>@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "—" : Model.CreatedBy)</td></tr>
        </tbody>
    </table></div>
</div></div>
