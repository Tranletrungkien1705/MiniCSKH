@model ServiceImprovement
@{
    ViewData["Title"] = "Chi tiết bộ cải tiến";
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Cải tiến chất lượng</a>
        <h5 class="fw-bold mb-1 mt-1">@Model.Name
            @if(Model.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}
            else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</h5>
        <div class="text-muted small"><span class="font-monospace">@Model.Code</span> · @Ui.SvImprvTypeBadge(Model.ItemType) · tạo @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Sửa</a>
        <form asp-action="Toggle" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-sm @(Model.IsActive?"btn-outline-secondary":"btn-primary")">
                <i class="bi bi-toggle-@(Model.IsActive?"off":"on") me-1"></i>@(Model.IsActive?"Ngừng dùng":"Kích hoạt")</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Số tiêu chí</div><div class="fs-3 fw-bold">@Model.CriterionCount</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Bắt buộc</div><div class="fs-3 fw-bold text-warning">@Model.RequiredCount</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Đã sử dụng</div><div class="fs-5 fw-bold">@(Model.UsedAt?.ToString("dd/MM/yyyy") ?? "Chưa")</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Cập nhật</div><div class="fs-5 fw-bold">@Model.UpdatedAt.ToString("dd/MM HH:mm")</div></div></div></div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Remark))
{
    <div class="alert alert-light border"><i class="bi bi-info-circle me-1"></i>@Model.Remark</div>
}

<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-list-check me-1"></i>Các tiêu chí</h6>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th style="width:50px">#</th><th>Tiêu chí</th><th>Ngưỡng giá trị</th><th>Bắt buộc</th><th>Trạng thái</th></tr></thead>
        <tbody>
            @if(!Model.Criteria.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Bộ tiêu chí chưa có tiêu chí nào</td></tr>}
            @{ var idx = 0; }
            @foreach (var c in Model.Criteria)
            {
                idx++;
                <tr>
                    <td class="text-muted">@idx</td>
                    <td><i class="bi @Ui.SvImprvTypeIcon(c.Kind) me-1 text-muted"></i>@c.Word</td>
                    <td class="small text-muted">@c.RangeText</td>
                    <td>@if(c.IsRequired){<i class="bi bi-check-circle-fill text-warning"></i>}else{<span class="text-muted">—</span>}</td>
                    <td>@if(c.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Tắt</span>}</td>
                </tr>
            }
        </tbody>
    </table></div>
</div></div>
