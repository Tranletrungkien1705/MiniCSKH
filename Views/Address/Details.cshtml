@model Address
@{
    ViewData["Title"] = "Chi tiết địa chỉ";
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Danh mục địa chỉ</a>
        <h5 class="fw-bold mb-1 mt-1"><i class="bi bi-geo me-1"></i>@Model.Name <span class="font-monospace text-muted">@Model.Code</span></h5>
        <div class="text-muted small">tạo @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") · cập nhật @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Sửa</a>
        <form asp-action="Toggle" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-toggle2-on me-1"></i>@(Model.IsActive ? "Ngừng dùng" : "Kích hoạt")</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Cấp địa chỉ</div><div class="fs-6 fw-bold">@Html.Raw(Ui.AddressLevelBadge(Model.Level))</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Mã địa chỉ (Code)</div><div class="fs-6 fw-bold font-monospace">@Model.Code</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Cấp trên (ParentCode)</div><div class="fs-6 fw-bold font-monospace">@(string.IsNullOrWhiteSpace(Model.ParentCode) ? "— (cấp gốc)" : Model.ParentCode)</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Trạng thái (FlagActive)</div>
        <div class="fs-6 fw-bold">@if(Model.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</div></div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Mã bưu chính (PostCode)</div><div class="fs-6 fw-bold">@(string.IsNullOrWhiteSpace(Model.PostCode) ? "—" : Model.PostCode)</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Mã quốc gia (CountryCode)</div><div class="fs-6 fw-bold">@(string.IsNullOrWhiteSpace(Model.CountryCode) ? "—" : Model.CountryCode)</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body">
        <div class="text-muted small text-uppercase">Người tạo (LogLUBy)</div><div class="fs-6 fw-bold">@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "—" : Model.CreatedBy)</div></div></div></div>
</div>