@model List<Address>
@{
    ViewData["Title"] = "Danh mục địa chỉ";
    var stats = (AddressStats)ViewBag.Stats;
    var level = (AddressLevel?)ViewBag.Level;
    var active = (bool?)ViewBag.Active;
    var parentCode = (string?)ViewBag.ParentCode;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-geo me-2"></i>Danh mục địa chỉ</h5>
        <small class="text-muted">Địa chỉ hành chính 3 cấp: Tỉnh/Thành → Quận/Huyện → Phường/Xã (Mst_Province / Mst_District / Mst_Ward)</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm địa chỉ</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng địa chỉ</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-geo fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tỉnh / Quận / Phường</div><div class="fs-5 fw-bold text-info">@stats.Provinces / @stats.Districts / @stats.Wards</div></div>
        <i class="bi bi-diagram-3 fs-2 text-info opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Ngừng dùng</div><div class="fs-3 fw-bold text-secondary">@(stats.Total - stats.Active)</div></div>
        <i class="bi bi-slash-circle fs-2 text-secondary opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Cấp</label>
        <select name="level" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="0" selected="@(level==AddressLevel.Province)">Tỉnh / Thành phố</option>
            <option value="1" selected="@(level==AddressLevel.District)">Quận / Huyện</option>
            <option value="2" selected="@(level==AddressLevel.Ward)">Phường / Xã</option>
        </select></div>
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col-auto"><label class="form-label small mb-1">Cấp trên</label>
        <input name="parentCode" value="@parentCode" class="form-control form-control-sm" placeholder="VD: 01" /></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / tên địa chỉ" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Tên địa chỉ</th><th>Cấp</th><th>Cấp trên</th><th>Mã bưu chính</th><th>Trạng thái</th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có địa chỉ</td></tr>}
        @foreach (var a in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/Address/Details/@a.Id'">
                <td><span class="font-monospace small fw-semibold">@a.Code</span></td>
                <td class="fw-semibold">@a.Name</td>
                <td>@Html.Raw(Ui.AddressLevelBadge(a.Level))</td>
                <td>@if(!string.IsNullOrWhiteSpace(a.ParentCode)){<span class="font-monospace small">@a.ParentCode</span>}else{<span class="text-muted small">— (cấp gốc)</span>}</td>
                <td class="small">@(string.IsNullOrWhiteSpace(a.PostCode) ? "—" : a.PostCode)</td>
                <td>@if(a.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</td>
            </tr>
        }
    </tbody>
</table></div></div>