@model List<ReminderRule>
@{
    ViewData["Title"] = "Nhắc nhở phiếu";
    var stats = (ReminderStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var channel = (RemindChannel?)ViewBag.Channel;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-bell me-2"></i>Nhắc nhở phiếu</h5>
        <small class="text-muted">Cấu hình kênh thông báo khi phiếu tới hạn / quá hạn xử lý</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Tạo thiết lập</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng thiết lập</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-bell fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Kênh Email</div><div class="fs-3 fw-bold text-info">@stats.Email</div></div>
        <i class="bi bi-envelope fs-2 text-info opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Kênh SMS / Zalo</div><div class="fs-3 fw-bold text-warning">@stats.Sms / @stats.Zalo</div></div>
        <i class="bi bi-chat-dots fs-2 text-warning opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col-auto"><label class="form-label small mb-1">Kênh</label>
        <select name="channel" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            @foreach (var c in Enum.GetValues<RemindChannel>())
            {
                <option value="@c" selected="@(channel==c)">@Ui.RemindChannelName(c)</option>
            }
        </select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã thiết lập / ghi chú" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã thiết lập</th><th>Kênh nhắc nhở</th><th>Mẫu nội dung</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có thiết lập nhắc nhở</td></tr>}
        @foreach (var r in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/Reminder/Details/@r.Id'">
                <td><span class="font-monospace small fw-semibold">@r.EstablishId</span>
                    @if(!string.IsNullOrWhiteSpace(r.Remark)){<div class="small text-muted">@r.Remark</div>}</td>
                <td>
                    @if(r.ChannelCount == 0){<span class="text-muted small">—</span>}
                    else{@foreach(var c in r.Channels){@Html.Raw(Ui.RemindChannelBadge(c)) <text> </text>}}
                </td>
                <td class="small text-muted">
                    @if(!string.IsNullOrWhiteSpace(r.SubFormCodeEmail)){<div><i class="bi bi-envelope me-1"></i>@r.SubFormCodeEmail</div>}
                    @if(!string.IsNullOrWhiteSpace(r.SubFormCodeSms)){<div><i class="bi bi-chat-left-text me-1"></i>@r.SubFormCodeSms</div>}
                    @if(!string.IsNullOrWhiteSpace(r.SubFormCodeZalo)){<div><i class="bi bi-chat-dots me-1"></i>@r.SubFormCodeZalo</div>}
                    @if(string.IsNullOrWhiteSpace(r.SubFormCodeEmail) && string.IsNullOrWhiteSpace(r.SubFormCodeSms) && string.IsNullOrWhiteSpace(r.SubFormCodeZalo)){<span>—</span>}
                </td>
                <td>@if(r.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</td>
                <td class="small text-muted">@r.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table></div></div>
