@model List<TicketTypeDepartment>
@{
    ViewData["Title"] = "Gán loại phiếu — phòng ban";
    var stats = (TicketTypeDepartmentStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var ticketTypeCode = (string?)ViewBag.TicketTypeCode;
    var departmentCode = (string?)ViewBag.DepartmentCode;
    var q = (string?)ViewBag.Q;
    var ticketTypes = (List<TicketType>)ViewBag.TicketTypes;
    var departments = (List<Department>)ViewBag.Departments;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-diagram-3 me-2"></i>Gán loại phiếu — phòng ban</h5>
        <small class="text-muted">Phòng ban nào phụ trách xử lý loại phiếu nào (Map_TicketTypeDepartment)</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm gán</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng gán</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-diagram-3 fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Loại phiếu</div><div class="fs-3 fw-bold text-info">@stats.DistinctTicketTypes</div></div>
        <i class="bi bi-ticket-detailed fs-2 text-info opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Phòng ban</div><div class="fs-3 fw-bold text-warning">@stats.DistinctDepartments</div></div>
        <i class="bi bi-diagram-2 fs-2 text-warning opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col-auto"><label class="form-label small mb-1">Loại phiếu</label>
        <select name="ticketTypeCode" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            @foreach (var t in ticketTypes)
            {
                <option value="@t.Code" selected="@(ticketTypeCode==t.Code)">@t.Code — @t.AgentName</option>
            }
        </select></div>
    <div class="col-auto"><label class="form-label small mb-1">Phòng ban</label>
        <select name="departmentCode" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            @foreach (var d in departments)
            {
                <option value="@d.Code" selected="@(departmentCode==d.Code)">@d.Code — @d.Name</option>
            }
        </select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã loại phiếu / mã phòng ban" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th style="width:60px">Thứ tự</th><th>Loại phiếu</th><th>Phòng ban</th><th>Trạng thái</th><th style="width:90px"></th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có gán nào</td></tr>}
        @foreach (var m in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/TicketTypeDepartment/Details/@m.Id'">
                <td class="text-muted small">@m.Order</td>
                <td>@Html.Raw(Ui.TicketTypeCodeBadge(m.TicketTypeCode))</td>
                <td>@Html.Raw(Ui.DepartmentCodeBadge(m.DepartmentCode))</td>
                <td>@Html.Raw(Ui.TicketTypeDeptActiveBadge(m.IsActive))</td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-outline-primary btn-sm" onclick="event.stopPropagation()"><i class="bi bi-pencil"></i></a></td>
            </tr>
        }
    </tbody>
</table></div></div>
