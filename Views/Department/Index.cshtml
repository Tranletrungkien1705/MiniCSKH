@model List<Department>
@{
    ViewData["Title"] = "Phòng ban";
    var stats = (DepartmentStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-diagram-2 me-2"></i>Phòng ban</h5>
        <small class="text-muted">Đơn vị tổ chức nhận &amp; xử lý phiếu, có phân cấp (Mst_Department)</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm phòng ban</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng phòng ban</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-diagram-2 fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Cấp 1 / Chia đều</div><div class="fs-3 fw-bold text-info">@stats.Root / @stats.AutoDiv</div></div>
        <i class="bi bi-shuffle fs-2 text-info opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Thành viên</div><div class="fs-3 fw-bold text-warning">@stats.Members</div></div>
        <i class="bi bi-people fs-2 text-warning opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / tên / mô tả phòng ban" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Tên phòng ban</th><th>Cấp</th><th>Cấp trên</th><th>Thành viên</th><th>Chia đều</th><th>Trạng thái</th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có phòng ban</td></tr>}
        @foreach (var d in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/Department/Details/@d.Id'">
                <td><span class="font-monospace small fw-semibold">@d.Code</span>
                    @if(!string.IsNullOrWhiteSpace(d.Description)){<div class="small text-muted">@d.Description</div>}</td>
                <td class="fw-semibold">@d.Name</td>
                <td>@Html.Raw(Ui.DepartmentLevelBadge(d.Level))</td>
                <td class="small text-muted">@(string.IsNullOrWhiteSpace(d.ParentCode) ? "—" : d.ParentCode)</td>
                <td><span class="badge bg-light text-dark border"><i class="bi bi-people me-1"></i>@d.MemberCount</span></td>
                <td>@if(d.AutoDiv){<span class="badge bg-info-subtle text-info border-info-subtle">Bật</span>}else{<span class="text-muted small">—</span>}</td>
                <td>@if(d.IsActive){<span class="badge bg-success-subtle text-success border-success-subtle">Đang dùng</span>}else{<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">Ngừng dùng</span>}</td>
            </tr>
        }
    </tbody>
</table></div></div>
