@model Department
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm phòng ban" : "Sửa phòng ban";
    var members = Model.Members.ToList();
    if (members.Count == 0) members.Add(new DepartmentMember());
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Phòng ban</a>
        <h5 class="fw-bold mb-0 mt-1">@ViewData["Title"]</h5>
    </div>
</div>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card mb-3"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1"></i>Thông tin phòng ban</h6>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label small">Mã phòng ban (DepartmentCode)</label>
                <input name="Code" value="@Model.Code" class="form-control form-control-sm" placeholder="VD: PB-KYTHUAT" />
                <div class="form-text">Để trống sẽ tự sinh mã.</div></div>
            <div class="col-md-4"><label class="form-label small">Tên phòng ban <span class="text-danger">*</span></label>
                <input name="Name" value="@Model.Name" class="form-control form-control-sm" placeholder="VD: Phòng Kỹ thuật" required /></div>
            <div class="col-md-4"><label class="form-label small">Mã phòng ban cấp trên (DepartmentCodeParent)</label>
                <input name="ParentCode" value="@Model.ParentCode" class="form-control form-control-sm" placeholder="VD: PB-CSKH (để trống nếu là gốc)" /></div>
            <div class="col-md-3"><label class="form-label small">Cấp phòng ban (DepartmentLevel)</label>
                <input name="Level" type="number" min="1" value="@Model.Level" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small">Mã số thuế (MST)</label>
                <input name="TaxCode" value="@Model.TaxCode" class="form-control form-control-sm" placeholder="VD: 0101234567" /></div>
            <div class="col-md-3"><label class="form-label small">Thứ tự hiển thị (OrderIdx)</label>
                <input name="Order" type="number" value="@Model.Order" class="form-control form-control-sm" /></div>
            <div class="col-md-3 d-flex align-items-end"><div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="AutoDiv" value="true" id="autoDiv" @(Model.AutoDiv ? "checked" : "") />
                <label class="form-check-label small" for="autoDiv">Chia đều tự động (FlagAutoDiv)</label></div></div>
            <div class="col-12"><label class="form-label small">Mô tả</label>
                <input name="Description" value="@Model.Description" class="form-control form-control-sm" placeholder="Mô tả phòng ban" /></div>
            <div class="col-12"><div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label small" for="isActive">Đang dùng (FlagActive)</label></div></div>
        </div>
    </div></div>

    <div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0"><i class="bi bi-people me-1"></i>Thành viên phòng ban</h6>
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="addRow()"><i class="bi bi-plus-lg me-1"></i>Thêm thành viên</button>
        </div>
        <div class="table-responsive"><table class="table align-middle mb-0" id="memberTable">
            <thead><tr><th style="width:22%">Mã nhân viên (UserCode)</th><th style="width:26%">Họ tên</th><th>Email</th><th>Điện thoại</th><th style="width:40px"></th></tr></thead>
            <tbody>
                @foreach (var m in members)
                {
                    <tr>
                        <td><input name="memberUserCode" value="@m.UserCode" class="form-control form-control-sm" placeholder="VD: ha.nguyen" /></td>
                        <td><input name="memberFullName" value="@m.FullName" class="form-control form-control-sm" placeholder="VD: Nguyễn Thu Hà" /></td>
                        <td><input name="memberEmail" value="@m.Email" class="form-control form-control-sm" placeholder="email@cskh.vn" /></td>
                        <td><input name="memberPhone" value="@m.Phone" class="form-control form-control-sm" placeholder="0901234567" /></td>
                        <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>
                    </tr>
                }
            </tbody>
        </table></div>
        <div class="small text-muted mt-2"><i class="bi bi-info-circle me-1"></i>Thành viên là các agent thuộc phòng ban (Sys_UserMapDepartment). Khi bật "Chia đều tự động", phiếu mới về phòng ban sẽ được chia đều cho các thành viên.</div>
    </div></div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Lưu phòng ban</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy</a>
    </div>
</form>

@section Scripts {
<script>
    function addRow() {
        const tb = document.querySelector('#memberTable tbody');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><input name="memberUserCode" class="form-control form-control-sm" placeholder="VD: ha.nguyen" /></td>
            <td><input name="memberFullName" class="form-control form-control-sm" placeholder="VD: Nguyễn Thu Hà" /></td>
            <td><input name="memberEmail" class="form-control form-control-sm" placeholder="email@cskh.vn" /></td>
            <td><input name="memberPhone" class="form-control form-control-sm" placeholder="0901234567" /></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('tr').remove()"><i class="bi bi-x-lg"></i></button></td>`;
        tb.appendChild(tr);
    }
</script>
}
