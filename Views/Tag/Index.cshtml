@model List<Tag>
@{
    ViewData["Title"] = "Thẻ";
    var stats = (TagStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-tags-fill me-2"></i>Thẻ</h5>
        <small class="text-muted">Nhãn dùng chung để gắn/phân loại nội dung CSKH (Mst_Tag)</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm thẻ</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Tổng thẻ</div><div class="fs-3 fw-bold">@stats.Total</div></div>
        <i class="bi bi-tags fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang dùng</div><div class="fs-3 fw-bold text-success">@stats.Active</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Có slug</div><div class="fs-3 fw-bold text-info">@stats.WithSlug</div></div>
        <i class="bi bi-link-45deg fs-2 text-info opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Ngừng dùng</div><div class="fs-3 fw-bold text-secondary">@stats.Inactive</div></div>
        <i class="bi bi-toggle-off fs-2 text-secondary opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Trạng thái</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">Tất cả</option>
            <option value="true" selected="@(active==true)">Đang dùng</option>
            <option value="false" selected="@(active==false)">Ngừng dùng</option>
        </select></div>
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / tên / mô tả / slug" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Tên thẻ</th><th>Slug</th><th>Mô tả</th><th>Trạng thái</th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có thẻ</td></tr>}
        @foreach (var t in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/Tag/Details/@t.Id'">
                <td><span class="font-monospace small fw-semibold">@t.Code</span></td>
                <td class="fw-semibold"><i class="bi bi-tag me-1 text-muted"></i>@t.Name</td>
                <td><span class="badge bg-light text-dark border font-monospace">@t.SlugText</span></td>
                <td class="small text-muted">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                <td>@Html.Raw(Ui.TagActiveBadge(t.IsActive))</td>
            </tr>
        }
    </tbody>
</table></div></div>