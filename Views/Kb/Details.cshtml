@model KbArticle
@{ ViewData["Title"] = Model.Title; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Knowledge Base</a>
</div>
<div class="card"><div class="card-body">
    <span class="badge bg-primary-subtle text-primary mb-2">@Model.Category</span>
    <h4 class="fw-bold">@Model.Title</h4>
    <div class="small text-muted mb-3"><i class="bi bi-eye me-1"></i>@Model.Views lượt xem · cập nhật @Model.UpdatedAt.ToString("dd/MM/yyyy")</div>
    <div style="white-space:pre-wrap;line-height:1.7">@Model.Body</div>
</div></div>
