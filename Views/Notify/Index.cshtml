@model List<NotifyType>
@{
    ViewData["Title"] = "Quản lý thông báo";
    var stats = (NotifyStats)ViewBag.Stats;
    var active = (bool?)ViewBag.Active;
    var q = (string?)ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-bell me-2"></i>Quản lý thông báo</h5>
        <small class="text-muted">Danh mục loại thông báo nội bộ (Mst_NotifyType)</small></div>
    <div class="d-flex gap-2">
        <a asp-action="Managers" class="btn btn-outline-primary btn-sm"><i class="bi bi-people me-1"></i>Người nhận</a>
        <a asp-action="Matrix" class="btn btn-outline-primary btn-sm"><i class="bi bi-grid-3x3-gap me-1"></i>Ma trận phân quyền</a>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm loại thông báo</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Loại thông báo</div><div class="fs-3 fw-bold">@stats.Types</div></div>
        <i class="bi bi-bell fs-2 text-primary opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Bật mặc định</div><div class="fs-3 fw-bold text-success">@stats.ActiveTypes</div></div>
        <i class="bi bi-toggle-on fs-2 text-success opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Người nhận</div><div class="fs-3 fw-bold text-info">@stats.Managers</div></div>
        <i class="bi bi-people fs-2 text-info opacity-50"></i></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body d-flex justify-content-between align-items-center">
        <div><div class="text-muted small text-uppercase">Đang nhận</div><div class="fs-3 fw-bold text-warning">@stats.EnabledSubscriptions</div></div>
        <i class="bi bi-check2-square fs-2 text-warning opacity-50"></i></div></div></div>
</div>

<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col"><label class="form-label small mb-1">Tìm</label><input name="q" value="@q" class="form-control form-control-sm" placeholder="Mã / mô tả loại thông báo" /></div>
    <div class="col-auto"><label class="form-label small mb-1">Mặc định</label>
        <select name="active" class="form-select form-select-sm">
            <option value="">— Tất cả —</option>
            <option value="true" selected="@(active==true)">Bật mặc định</option>
            <option value="false" selected="@(active==false)">Tắt mặc định</option>
        </select></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Mô tả</th><th>Mặc định</th><th></th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="4" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Chưa có loại thông báo</td></tr>}
        @foreach (var t in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/Notify/Details/@t.Id'">
                <td><span class="font-monospace small fw-semibold"><i class="bi @Ui.NotifyTypeIcon(t.Code) me-1"></i>@t.Code</span></td>
                <td class="fw-semibold">@t.DisplayName</td>
                <td>@Html.Raw(Ui.NotifyActiveBadge(t.DefaultActive))</td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-outline-primary btn-sm" onclick="event.stopPropagation()"><i class="bi bi-pencil me-1"></i>Sửa</a></td>
            </tr>
        }
    </tbody>
</table></div></div>
